export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
export LD_PRELOAD="${LD_PRELOAD:-$PREFIX/lib/libtermux-exec.so}"
# Resolve the mutable `current` symlink once, so this shell keeps using the
# same immutable generation after a later activation switches `current`.
if [[ -n "${TERMUX_NATIVE_GENERATION_OVERRIDE:-}" ]]
then
  TERMUX_GENERATION="$TERMUX_NATIVE_GENERATION_OVERRIDE"
  ZDOTDIR="${TERMUX_NATIVE_ZDOTDIR:-$TERMUX_GENERATION/home/.config/zsh}"
else
  TERMUX_GENERATION="$HOME/.local/share/termux-native/current"
fi
TERMUX_GENERATION="${TERMUX_GENERATION:P}"
if [[ -z "${TERMUX_NATIVE_GENERATION_OVERRIDE:-}" ]]
then
  ZDOTDIR="$TERMUX_GENERATION/home/.config/zsh"
fi
unset TERMUX_NATIVE_GENERATION_OVERRIDE TERMUX_NATIVE_ZDOTDIR
if [[ ! -d "$TERMUX_GENERATION" ]]; then
  print -u2 -r -- "Termux native generation is unavailable: $TERMUX_GENERATION"
  exit 1
fi
export TERMUX_GENERATION
export ZDOTDIR

# A child shell inherits Home Manager's session-vars-loaded marker. Clear it
# only when the resolved generation changes so login shells load that
# generation's variables while same-generation subshells preserve overrides.
if [[ "${TERMUX_NATIVE_SESSION_VARS_GENERATION:-}" != "$TERMUX_GENERATION" ]]
then
  unset __HM_ZSH_SESS_VARS_SOURCED
  export TERMUX_NATIVE_SESSION_VARS_GENERATION="$TERMUX_GENERATION"
fi

typeset -g _termux_native_generation_root="$HOME/.local/share/termux-native/generations"
typeset -g _termux_native_local_plugin_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/local-plugins"
typeset -U path fpath
path=("${path[@]:#${_termux_native_generation_root}/*}")
fpath=("${fpath[@]:#${_termux_native_generation_root}/*}")
fpath=("${fpath[@]:#${_termux_native_local_plugin_cache}/*}")
path=("$TERMUX_GENERATION/bin" "$PREFIX/bin" $path)
unset ZSH_LOCAL_PLUGIN_CACHE_DIR ZSH_LOCAL_PLUGINS_CACHE_BUILD __zlp_build
unset _termux_native_generation_root _termux_native_local_plugin_cache

if [[ -r "$HOME/.config/zsh/.zshenv" && -r "$HOME/.config/zsh/.zshrc" ]]
then
  export TERMUX_NATIVE_YADM_CONFIG=1
else
  unset TERMUX_NATIVE_YADM_CONFIG
fi

