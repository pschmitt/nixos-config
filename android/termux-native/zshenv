export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
export LD_PRELOAD="${LD_PRELOAD:-$PREFIX/lib/libtermux-exec.so}"

# Termux's zsh seeds its initial logical $PWD from a compiled-in stock home
# (files/home below the stock app data directory) whenever that path is the
# current directory. Forked app IDs reach it through the prefix redirect, so a new
# shell started in the fork's home would report the stock path while the kernel
# is in the fork's directory. Respell exactly that artifact with the fork's own
# home. Any other directory, an unset or stock app data directory, or a $PWD
# that is not the current directory is left alone.
# The stock path is assembled so build-time relocation cannot rewrite it.
typeset -g _termux_stock_data="${TERMUX_NATIVE_STOCK_DATA_DIR:-/data/data/com.""termux}"
if [[ -n "${TERMUX_APP__DATA_DIR:-}" &&
      "$TERMUX_APP__DATA_DIR" != "$_termux_stock_data" &&
      "$PWD" == "$_termux_stock_data/files/home" &&
      "$TERMUX_APP__DATA_DIR/files/home" -ef . ]]
then
  builtin cd -q -- "$TERMUX_APP__DATA_DIR/files/home" && OLDPWD="$PWD"
fi
unset _termux_stock_data

# Resolve the mutable `current` symlink once, so this shell keeps using the
# same immutable generation after a later activation switches `current`.
if [[ -n "${TERMUX_NATIVE_GENERATION_OVERRIDE:-}" ]]
then
  TERMUX_GENERATION="$TERMUX_NATIVE_GENERATION_OVERRIDE"
  ZDOTDIR="${TERMUX_NATIVE_ZDOTDIR:-$TERMUX_GENERATION/home/.config/zsh}"
else
  TERMUX_GENERATION="$HOME/.local/share/termux-native/current"
fi
TERMUX_GENERATION="${TERMUX_GENERATION:P}"
if [[ -z "${TERMUX_NATIVE_GENERATION_OVERRIDE:-}" ]]
then
  ZDOTDIR="$TERMUX_GENERATION/home/.config/zsh"
fi
unset TERMUX_NATIVE_GENERATION_OVERRIDE TERMUX_NATIVE_ZDOTDIR
if [[ ! -d "$TERMUX_GENERATION" ]]; then
  print -u2 -r -- "Termux native generation is unavailable: $TERMUX_GENERATION"
  exit 1
fi
export TERMUX_GENERATION
export ZDOTDIR

# PID start times distinguish live shells from stale records after PID reuse.
if [[ "$TERMUX_GENERATION" == "$HOME/.local/share/termux-native/generations/"* &&
      -r /proc/$$/stat ]]
then
  typeset -g _termux_native_session_dir="$HOME/.local/share/termux-native/sessions"
  typeset -g _termux_native_process_stat
  typeset -ga _termux_native_process_fields
  IFS= read -r _termux_native_process_stat < /proc/$$/stat
  _termux_native_process_stat="${_termux_native_process_stat##*\) }"
  _termux_native_process_fields=( ${=_termux_native_process_stat} )
  if [[ "${_termux_native_process_fields[20]:-}" == <-> ]] &&
      mkdir -p -- "$_termux_native_session_dir"
  then
    print -r -- "${_termux_native_process_fields[20]} ${TERMUX_GENERATION:t}" \
      > "$_termux_native_session_dir/$$.next" &&
      mv -f -- "$_termux_native_session_dir/$$.next" "$_termux_native_session_dir/$$"
  fi
  unset _termux_native_session_dir _termux_native_process_stat _termux_native_process_fields
fi

# Older global zshenv files update TERMUX_NATIVE_SESSION_VARS_GENERATION before
# clearing both Home Manager guards. Use a separate marker for this protocol.
if [[ "${TERMUX_NATIVE_HM_SESSION_GENERATION:-}" != "$TERMUX_GENERATION" ]]
then
  unset __HM_SESS_VARS_SOURCED __HM_ZSH_SESS_VARS_SOURCED
  export TERMUX_NATIVE_HM_SESSION_GENERATION="$TERMUX_GENERATION"
fi
export TERMUX_NATIVE_SESSION_VARS_GENERATION="$TERMUX_GENERATION"

typeset -g _termux_native_generation_root="$HOME/.local/share/termux-native/generations"
typeset -g _termux_native_local_plugin_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/local-plugins"
typeset -U path fpath
path=("${path[@]:#${_termux_native_generation_root}/*}")
fpath=("${fpath[@]:#${_termux_native_generation_root}/*}")
fpath=("${fpath[@]:#${_termux_native_local_plugin_cache}/*}")
path=("$TERMUX_GENERATION/bin" "$PREFIX/bin" $path)
unset ZSH_LOCAL_PLUGIN_CACHE_DIR ZSH_LOCAL_PLUGINS_CACHE_BUILD __zlp_build
unset _termux_native_generation_root _termux_native_local_plugin_cache

if [[ -r "$HOME/.config/zsh/.zshenv" && -r "$HOME/.config/zsh/.zshrc" ]]
then
  export TERMUX_NATIVE_YADM_CONFIG=1
else
  unset TERMUX_NATIVE_YADM_CONFIG
fi

