diff --git a/src/daemon/termuxpp.rs b/src/daemon/termuxpp.rs
new file mode 100644
index 0000000..b94fb30
--- /dev/null
+++ b/src/daemon/termuxpp.rs
@@ -0,0 +1,78 @@
+use std::process::Stdio;
+use std::time::Duration;
+
+use anyhow::{Context, Result, bail, ensure};
+use async_trait::async_trait;
+use tokio::io::AsyncReadExt;
+use tokio::process::Command;
+
+use crate::clipboard::{ClipboardBackend, Snapshot, add_portable_aliases};
+use crate::model::Representation;
+
+pub(super) struct TermuxClipboard {
+    max_bytes: u64,
+}
+
+impl TermuxClipboard {
+    pub(super) fn new(max_bytes: u64) -> Self {
+        Self { max_bytes }
+    }
+
+    async fn read_text(&self) -> Result<Vec<u8>> {
+        let mut child = Command::new("tpp")
+            .args(["clipboard", "get"])
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true)
+            .spawn()
+            .context("start tpp clipboard get")?;
+        let stdout = child.stdout.take().context("open tpp clipboard output")?;
+        let mut data = Vec::new();
+        stdout
+            .take(self.max_bytes.saturating_add(1))
+            .read_to_end(&mut data)
+            .await
+            .context("read tpp clipboard output")?;
+        ensure!(
+            data.len() as u64 <= self.max_bytes,
+            "clipboard exceeds configured limit"
+        );
+        let status = child.wait().await.context("wait for tpp clipboard get")?;
+        ensure!(status.success(), "tpp clipboard get exited with {status}");
+        Ok(data)
+    }
+}
+
+#[async_trait]
+impl ClipboardBackend for TermuxClipboard {
+    async fn capture(&self) -> Result<Option<Snapshot>> {
+        let data = tokio::time::timeout(Duration::from_secs(3), self.read_text())
+            .await
+            .context("tpp clipboard get timed out")??;
+        if data.is_empty() {
+            return Ok(None);
+        }
+        std::str::from_utf8(&data).context("tpp clipboard output is not UTF-8")?;
+        let remaining = self.max_bytes - data.len() as u64;
+        let mut representations = vec![Representation {
+            item: 0,
+            format: "UTF8_STRING".into(),
+            data,
+        }];
+        add_portable_aliases(&mut representations, remaining);
+        Ok(Some(Snapshot::new(representations)))
+    }
+
+    async fn apply(&self, _: &[Representation]) -> Result<Snapshot> {
+        bail!("Android clipboard bridge is push-only")
+    }
+
+    fn name(&self) -> &'static str {
+        "TermuxPP (push-only)"
+    }
+
+    fn is_push_only(&self) -> bool {
+        true
+    }
+}
