 pub const DEFAULT_READ_TIMEOUT: u64 = 500;
 
+// Drop an INCR transfer whose requestor stopped asking for chunks
+const INCR_TRANSFER_TIMEOUT: Duration = Duration::from_secs(30);
+
+// Payloads above this are sent with INCR (ICCCM 2.7.2); a single
+// ChangeProperty larger than the maximum request length is rejected
+fn incr_chunk_size(conn: &RustConnection) -> usize {
+	(conn.maximum_request_bytes() / 4).clamp(4096, 1 << 20)
+}
+
+// An outgoing INCR transfer: the requestor deletes the property to ask for
+// the next chunk and a zero-length chunk ends the transfer
+struct IncrTransfer {
+	requestor: u32,
+	property: Atom,
+	target: Atom,
+	data: Vec<u8>,
+	offset: usize,
+	last_activity: Instant,
+}
+
+impl IncrTransfer {
+	// Write the next chunk; returns true once the final empty chunk is written
+	fn send_next(&mut self, ctx: &XServerContext) -> Result<bool> {
+		let end = (self.offset + incr_chunk_size(&ctx.conn)).min(self.data.len());
+		let finished = self.offset == self.data.len();
+		ctx.conn.change_property8(
+			PropMode::REPLACE,
+			self.requestor,
+			self.property,
+			self.target,
+			&self.data[self.offset..end],
+		)?;
+		self.offset = end;
+		self.last_activity = Instant::now();
+		if finished {
+			ctx.conn.change_window_attributes(
+				self.requestor,
+				&ChangeWindowAttributesAux::new().event_mask(EventMask::NO_EVENT),
+			)?;
+		}
+		ctx.conn.flush()?;
+		Ok(finished)
+	}
+}
