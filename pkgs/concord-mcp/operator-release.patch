--- a/src/tools/task-lifecycle.ts
+++ b/src/tools/task-lifecycle.ts
@@ -269,3 +269,71 @@ export function handleReopenTask(repos: Repositories, input: ReopenTaskInput): T
     reason: input.reason,
   });
 }
+
+export interface OperatorReleaseInput {
+  task_id: string;
+  /** Local user running the CLI; recorded as the actor `operator:<name>`. */
+  operator: string;
+  /** Close the task (keeps the former owner) instead of leaving it unowned. */
+  close: boolean;
+  reason: string;
+}
+
+/**
+ * Operator override for a task whose owning session is gone. It skips the
+ * owner check on purpose and is reachable only from the local `concord
+ * release` command, never from an MCP tool. The audit trail records the actor
+ * as `operator:<name>` together with the mandatory reason.
+ */
+export function handleOperatorRelease(
+  repos: Repositories,
+  input: OperatorReleaseInput,
+): TaskLifecycleResult {
+  const task = repos.tasks.get(input.task_id);
+  if (task === undefined) {
+    throw new Error(`Task ${input.task_id} is not claimed.`);
+  }
+  if (task.status === 'closed' || task.status === 'complete') {
+    throw new Error(`Task ${task.taskId} is already ${task.status}.`);
+  }
+  return applyTransition(repos, {
+    task,
+    transition: input.close ? 'operator_close' : 'operator_release',
+    tool: input.close ? 'close_task' : 'release_task',
+    actorAgentId: `operator:${input.operator}`,
+    status: input.close ? 'closed' : 'proposed',
+    agentId: input.close ? task.agentId : null,
+    assignedAgentId: null,
+    leaseExpiresAt: null,
+    reason: input.reason,
+  });
+}
+
+const CLAIM_STATUSES = [
+  'assigned',
+  'active',
+  'blocked',
+  'handoff_offered',
+] as const satisfies readonly TaskStatus[];
+
+/**
+ * Claims that nothing has touched since `cutoffMs` (for example the last
+ * boot): the task has no later activity, and neither its owner nor its
+ * assignee was seen again. An agent that is missing, or has an unreadable
+ * timestamp, counts as gone.
+ */
+export function findClaimsStaleSince(repos: Repositories, cutoffMs: number): TaskRecord[] {
+  const before = (iso: string): boolean => {
+    const time = Date.parse(iso);
+    return Number.isNaN(time) || time < cutoffMs;
+  };
+  return repos.tasks.listByStatuses(CLAIM_STATUSES).filter(
+    (task) =>
+      before(task.updatedAt) &&
+      [task.agentId, task.assignedAgentId].every((agentId) => {
+        if (agentId === null) return true;
+        const agent = repos.agents.get(agentId);
+        return agent === undefined || before(agent.lastSeen);
+      }),
+  );
+}
