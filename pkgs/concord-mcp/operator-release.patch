@@ -0,0 +1,125 @@
+import type { Command } from '@commander-js/extra-typings';
+import { uptime, userInfo } from 'node:os';
+import { z } from 'zod';
+
+import { createRepositories, type Repositories } from '../../db/index.js';
+import {
+  findClaimsStaleSince,
+  handleOperatorRelease,
+  type TaskLifecycleResult,
+} from '../../tools/task-lifecycle.js';
+import { openContext } from '../context.js';
+
+export interface ReleaseOptions {
+  close: boolean;
+  reason?: string | undefined;
+  /** Release every claim in every workspace that nothing touched since boot. */
+  staleSinceBoot?: boolean | undefined;
+  dryRun?: boolean | undefined;
+}
+
+const projectRows = z.array(z.object({ project: z.string() }));
+
+/** When this machine booted, in ms since the epoch. */
+export function bootTimeMs(now: number = Date.now()): number {
+  return now - Math.round(uptime() * 1000);
+}
+
+function describe(result: TaskLifecycleResult, verb: string): string {
+  const { task, ownershipEvent } = result;
+  return (
+    `${verb} ${task.taskId}: ${ownershipEvent.fromStatus} -> ${task.status} ` +
+    `(v${String(ownershipEvent.fromVersion)} -> v${String(task.version)})`
+  );
+}
+
+/** Workspaces (projects) that have tasks in this database. */
+function projectsOf(repos: Repositories): string[] {
+  const raw: unknown = repos.db.prepare('SELECT DISTINCT project FROM tasks').all();
+  return projectRows.parse(raw).map((row) => row.project);
+}
+
+function runStaleSinceBoot(repos: Repositories, options: ReleaseOptions, bootMs: number): string {
+  const verb = options.close ? 'Closed' : 'Released';
+  const action = options.close ? 'close' : 'release';
+  const bootIso = new Date(bootMs).toISOString();
+  const reason = options.reason ?? `host rebooted at ${bootIso}`;
+  const lines: string[] = [];
+  for (const project of projectsOf(repos)) {
+    const scoped = createRepositories(repos.db, project);
+    for (const task of findClaimsStaleSince(scoped, bootMs)) {
+      if (options.dryRun === true) {
+        lines.push(`Would ${action} ${task.taskId} (${task.title})`);
+        continue;
+      }
+      const result = handleOperatorRelease(scoped, {
+        task_id: task.taskId,
+        operator: 'boot-cleanup',
+        close: options.close,
+        reason,
+      });
+      lines.push(`${describe(result, verb)}, recorded as operator:boot-cleanup.`);
+    }
+  }
+  if (lines.length === 0) {
+    return `No claims stale since boot (${bootIso}).`;
+  }
+  const count = `${String(lines.length)} claim(s) stale since boot (${bootIso})`;
+  return [...lines, options.dryRun === true ? `${count} would be released.` : `${count}.`].join(
+    '\n',
+  );
+}
+
+/**
+ * Release or close tasks whose owner session is gone, bypassing the owner
+ * check. For the person at the terminal: agents cannot reach this through MCP.
+ * With `staleSinceBoot`, it clears every claim in every workspace of this
+ * machine that nothing touched since the last boot (a reboot kills all agents).
+ */
+export function runRelease(
+  cwd: string,
+  taskId: string | undefined,
+  options: ReleaseOptions,
+  operator: string = userInfo().username,
+  bootMs: number = bootTimeMs(),
+): string {
+  if (options.staleSinceBoot === true) {
+    if (taskId !== undefined) {
+      throw new Error('Pass either a task id or --stale-since-boot, not both.');
+    }
+    return runStaleSinceBoot(openContext(cwd).repos, options, bootMs);
+  }
+  if (taskId === undefined || options.reason === undefined) {
+    throw new Error('A task id and --reason are required (or use --stale-since-boot).');
+  }
+  const result = handleOperatorRelease(openContext(cwd).repos, {
+    task_id: taskId,
+    operator,
+    close: options.close,
+    reason: options.reason,
+  });
+  return `${describe(result, options.close ? 'Closed' : 'Released')}, recorded as operator:${operator}.`;
+}
+
+export function registerReleaseCommand(program: Command): void {
+  program
+    .command('release')
+    .argument('[taskId]', 'the task to release')
+    .option('-r, --reason <text>', 'why the owner cannot do it (recorded in the audit trail)')
+    .option('--close', 'close the task instead of leaving it unowned')
+    .option(
+      '--stale-since-boot',
+      'release every claim in every workspace that nothing touched since the last boot',
+    )
+    .option('--dry-run', 'with --stale-since-boot: list the claims without changing them')
+    .description('Release or close a task whose owner session is gone (operator override)')
+    .action((taskId, options) => {
+      const message = runRelease(process.cwd(), taskId, {
+        close: options.close === true,
+        reason: options.reason,
+        staleSinceBoot: options.staleSinceBoot,
+        dryRun: options.dryRun,
+      });
+      process.stdout.write(`${message}\n`);
+    });
+}
