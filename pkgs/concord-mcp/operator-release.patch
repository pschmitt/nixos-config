+
+describe('runRelease', () => {
+  it('closes a task for a dead owner and reports the audited transition', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'concord-cli-release-'));
+    mkdirSync(join(dir, '.git'));
+    const repos = openRepositories(join(dir, '.concord', 'concord.db'));
+    handleClaimWork(repos, { task_id: 'TASK-9', title: 'Stale deploy', agent: 'codex' });
+
+    const message = runRelease(dir, 'TASK-9', { close: true, reason: 'owner gone' }, 'alex');
+
+    expect(message).toBe('Closed TASK-9: active -> closed (v1 -> v2), recorded as operator:alex.');
+  });
+
+  it('releases every claim in every workspace that nothing touched since boot', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'concord-cli-boot-'));
+    mkdirSync(join(dir, '.git'));
+    const repos = openRepositories(join(dir, '.concord', 'concord.db'));
+    handleClaimWork(repos, { task_id: 'A-1', title: 'First', agent: 'codex' });
+    // A second workspace in the same database, as in global mode.
+    handleClaimWork(createRepositories(repos.db, 'ws_other'), {
+      task_id: 'B-1',
+      title: 'Second',
+      agent: 'codex',
+    });
+    const future = Date.now() + 60_000;
+    const options = { close: false, staleSinceBoot: true } as const;
+
+    const dry = runRelease(dir, undefined, { ...options, dryRun: true }, 'alex', future);
+    expect(dry).toContain('Would release A-1');
+    expect(dry).toContain('Would release B-1');
+    expect(repos.tasks.get('A-1')?.status).toBe('active');
+
+    const done = runRelease(dir, undefined, options, 'alex', future);
+    expect(done).toContain(
+      'Released A-1: active -> proposed (v1 -> v2), recorded as operator:boot-cleanup.',
+    );
+    expect(done).toContain('Released B-1');
+    expect(repos.tasks.get('A-1')?.status).toBe('proposed');
+    expect(createRepositories(repos.db, 'ws_other').tasks.get('B-1')?.status).toBe('proposed');
+
+    expect(runRelease(dir, undefined, options, 'alex', future)).toMatch(
+      /^No claims stale since boot/,
+    );
+    expect(runRelease(dir, undefined, options, 'alex', Date.now() - 60_000)).toMatch(
+      /^No claims stale since boot/,
+    );
+  });
+
+  it('rejects a task id together with --stale-since-boot, and a missing reason', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'concord-cli-args-'));
+    mkdirSync(join(dir, '.git'));
+    expect(() => runRelease(dir, 'A-1', { close: false, staleSinceBoot: true }, 'alex')).toThrow(
+      /not both/,
+    );
+    expect(() => runRelease(dir, 'A-1', { close: false }, 'alex')).toThrow(/--reason/);
+  });
+});
