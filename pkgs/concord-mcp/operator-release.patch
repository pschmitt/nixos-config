+++ b/src/tools/task-lifecycle.ts
@@ -269,3 +269,42 @@ export function handleReopenTask(repos: Repositories, input: ReopenTaskInput): T
     reason: input.reason,
   });
 }
+
+export interface OperatorReleaseInput {
+  task_id: string;
+  /** Local user running the CLI; recorded as the actor `operator:<name>`. */
+  operator: string;
+  /** Close the task (keeps the former owner) instead of leaving it unowned. */
+  close: boolean;
+  reason: string;
+}
+
+/**
+ * Operator override for a task whose owning session is gone. It skips the
+ * owner check on purpose and is reachable only from the local `concord
+ * release` command, never from an MCP tool. The audit trail records the actor
+ * as `operator:<name>` together with the mandatory reason.
+ */
+export function handleOperatorRelease(
+  repos: Repositories,
+  input: OperatorReleaseInput,
+): TaskLifecycleResult {
+  const task = repos.tasks.get(input.task_id);
+  if (task === undefined) {
+    throw new Error(`Task ${input.task_id} is not claimed.`);
+  }
+  if (task.status === 'closed' || task.status === 'complete') {
+    throw new Error(`Task ${task.taskId} is already ${task.status}.`);
+  }
+  return applyTransition(repos, {
+    task,
+    transition: input.close ? 'operator_close' : 'operator_release',
+    tool: input.close ? 'close_task' : 'release_task',
+    actorAgentId: `operator:${input.operator}`,
+    status: input.close ? 'closed' : 'proposed',
+    agentId: input.close ? task.agentId : null,
+    assignedAgentId: null,
+    leaseExpiresAt: null,
+    reason: input.reason,
+  });
+}
