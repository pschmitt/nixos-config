diff --git a/src/term/transport.rs b/src/term/transport.rs
new file mode 100644
index 0000000..d313fde
--- /dev/null
+++ b/src/term/transport.rs
@@ -0,0 +1,254 @@
+//! Kitty APCs bypass tmux, while text and cursor addressing remain pane-local.
+
+use std::io::{self, Write};
+use std::process::Command;
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+pub fn in_tmux() -> bool {
+    static TMUX: OnceLock<bool> = OnceLock::new();
+    *TMUX.get_or_init(|| std::env::var_os("TMUX").is_some_and(|value| !value.is_empty()))
+}
+
+pub fn write(out: &mut impl Write, bytes: &[u8]) -> io::Result<()> {
+    if !in_tmux() {
+        return out.write_all(bytes);
+    }
+    let origin = if contains_placement(bytes) {
+        pane_origin()
+    } else {
+        (0, 0)
+    };
+    let mut encoded = Vec::with_capacity(bytes.len());
+    write_with_tmux(&mut encoded, bytes, true, origin)?;
+    out.write_all(&encoded)
+}
+
+fn contains_placement(bytes: &[u8]) -> bool {
+    bytes.windows(3).any(|part| part == b"\x1b_G")
+}
+
+/// Where the pane's top-left cell sits in the outer terminal, as zero-based
+/// `(left, top)`. tmux positions text itself but forwards graphics untouched, so
+/// the outer terminal needs the translated cursor address.
+///
+/// The pane moves when it is split, zoomed or the status line changes, so the
+/// answer is refreshed once a second rather than cached for the whole run.
+fn pane_origin() -> (u32, u32) {
+    static CACHE: Mutex<Option<(Instant, (u32, u32))>> = Mutex::new(None);
+    let mut cache = CACHE.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    if let Some((at, origin)) = *cache {
+        if at.elapsed() < Duration::from_secs(1) {
+            return origin;
+        }
+    }
+    let origin = query_pane_origin().unwrap_or_else(|| cache.map_or((0, 0), |(_, known)| known));
+    *cache = Some((Instant::now(), origin));
+    origin
+}
+
+fn query_pane_origin() -> Option<(u32, u32)> {
+    const FORMAT: &str = "#{pane_left} #{pane_top} #{?#{==:#{status-position},top},#{?#{==:#{status},off},0,#{?#{==:#{status},on},1,#{status}}},0}";
+    let mut command = Command::new("tmux");
+    command.args(["display-message", "-p"]);
+    if let Some(pane) = std::env::var_os("TMUX_PANE") {
+        command.arg("-t").arg(pane);
+    }
+    let output = command.arg(FORMAT).output().ok()?;
+    parse_origin(std::str::from_utf8(&output.stdout).ok()?)
+}
+
+fn parse_origin(text: &str) -> Option<(u32, u32)> {
+    let mut fields = text.split_whitespace().map(|field| field.parse::<u32>());
+    let left = fields.next()?.ok()?;
+    let top = fields.next()?.ok()?;
+    let status = fields.next().and_then(Result::ok).unwrap_or(0);
+    Some((left, top + status))
+}
+
+/// If `bytes` ends in an absolute cursor address, `(prefix length, row, col)`.
+fn trailing_cup(bytes: &[u8]) -> Option<(usize, u32, u32)> {
+    let body = bytes.strip_suffix(b"H")?;
+    let digits_start = body
+        .iter()
+        .rposition(|byte| !byte.is_ascii_digit())
+        .map_or(0, |index| index + 1);
+    let col: u32 = std::str::from_utf8(&body[digits_start..]).ok()?.parse().ok()?;
+    let body = body[..digits_start].strip_suffix(b";")?;
+    let digits_start = body
+        .iter()
+        .rposition(|byte| !byte.is_ascii_digit())
+        .map_or(0, |index| index + 1);
+    let row: u32 = std::str::from_utf8(&body[digits_start..]).ok()?.parse().ok()?;
+    let prefix = body[..digits_start].strip_suffix(b"\x1b[")?;
+    Some((prefix.len(), row, col))
+}
+
+pub fn append_passthrough(out: &mut Vec<u8>, bytes: &[u8]) {
+    if in_tmux() {
+        wrap(out, bytes).expect("writing into a Vec cannot fail");
+    } else {
+        out.extend_from_slice(bytes);
+    }
+}
+
+fn wrap(out: &mut impl Write, bytes: &[u8]) -> io::Result<()> {
+    out.write_all(b"\x1bPtmux;")?;
+    let mut rest = bytes;
+    while let Some(index) = rest.iter().position(|&byte| byte == 0x1b) {
+        out.write_all(&rest[..index])?;
+        out.write_all(b"\x1b\x1b")?;
+        rest = &rest[index + 1..];
+    }
+    out.write_all(rest)?;
+    out.write_all(b"\x1b\\")
+}
+
+fn write_with_tmux(
+    out: &mut impl Write,
+    mut bytes: &[u8],
+    tmux: bool,
+    origin: (u32, u32),
+) -> io::Result<()> {
+    if !tmux {
+        return out.write_all(bytes);
+    }
+    // Frame buffers contain complete APCs, including each 4096-byte image chunk.
+    let mut cursor: Option<(u32, u32)> = None;
+    while let Some(start) = bytes.windows(3).position(|part| part == b"\x1b_G") {
+        let Some(end) = bytes[start..].windows(2).position(|part| part == b"\x1b\\") else {
+            return out.write_all(bytes);
+        };
+        let end = start + end + 2;
+        let command = &bytes[start..end];
+        // An image lands at the outer terminal's cursor, which tmux knows nothing
+        // about. The cursor address that precedes a placement therefore travels
+        // inside the same envelope, shifted by the pane's position, and the outer
+        // cursor is put back so tmux's idea of it stays true.
+        //
+        // Chunked transmissions are placed when the last chunk arrives, and a delete
+        // may sit between the address and the placement, so a command that directly
+        // follows another one reuses that one's address.
+        let prefix = &bytes[..start];
+        let address = match trailing_cup(prefix) {
+            Some((keep, row, col)) => {
+                out.write_all(&prefix[..keep])?;
+                Some((row, col))
+            }
+            None if prefix.is_empty() => cursor,
+            None => {
+                out.write_all(prefix)?;
+                None
+            }
+        };
+        cursor = address;
+        if let Some((row, col)) = address {
+            let mut payload = Vec::with_capacity(command.len() + 24);
+            write!(payload, "\x1b7\x1b[{};{}H", row + origin.1, col + origin.0)?;
+            payload.extend_from_slice(command);
+            payload.extend_from_slice(b"\x1b8");
+            wrap(out, &payload)?;
+        } else {
+            wrap(out, command)?;
+        }
+        bytes = &bytes[end..];
+    }
+    out.write_all(bytes)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn outside_tmux_is_byte_identical() {
+        let input = b"\x1b[2;3H\x1b_Ga=T,m=0;AAAA\x1b\\text";
+        let mut output = Vec::new();
+        write_with_tmux(&mut output, input, false, (4, 1)).unwrap();
+        assert_eq!(output, input);
+    }
+
+    #[test]
+    fn placement_carries_its_translated_cursor_and_restores_the_outer_one() {
+        let mut output = Vec::new();
+        write_with_tmux(
+            &mut output,
+            b"hi\x1b[2;3H\x1b_Ga=T;AAAA\x1b\\text",
+            true,
+            (4, 1),
+        )
+        .unwrap();
+        assert_eq!(
+            output,
+            b"hi\x1bPtmux;\x1b\x1b7\x1b\x1b[3;7H\x1b\x1b_Ga=T;AAAA\x1b\x1b\\\x1b\x1b8\x1b\\text"
+        );
+    }
+
+    #[test]
+    fn graphics_without_a_cursor_address_are_only_wrapped() {
+        let mut output = Vec::new();
+        write_with_tmux(&mut output, b"x\x1b_Ga=d,d=A\x1b\\y", true, (4, 1)).unwrap();
+        assert_eq!(output, b"x\x1bPtmux;\x1b\x1b_Ga=d,d=A\x1b\x1b\\\x1b\\y");
+    }
+
+    #[test]
+    fn chunks_directly_after_a_placement_share_its_cursor_address() {
+        let mut output = Vec::new();
+        write_with_tmux(
+            &mut output,
+            b"\x1b[2;3H\x1b_Ga=T,m=1;AA\x1b\\\x1b_Gm=0;BB\x1b\\z",
+            true,
+            (4, 1),
+        )
+        .unwrap();
+        assert_eq!(
+            output,
+            b"\x1bPtmux;\x1b\x1b7\x1b\x1b[3;7H\x1b\x1b_Ga=T,m=1;AA\x1b\x1b\\\x1b\x1b8\x1b\\\x1bPtmux;\x1b\x1b7\x1b\x1b[3;7H\x1b\x1b_Gm=0;BB\x1b\x1b\\\x1b\x1b8\x1b\\z"
+        );
+    }
+
+    #[test]
+    fn trailing_cursor_address_is_recognised() {
+        assert_eq!(trailing_cup(b"ab\x1b[12;345H"), Some((2, 12, 345)));
+        assert_eq!(trailing_cup(b"\x1b[;3H"), None);
+        assert_eq!(trailing_cup(b"\x1b[2;3"), None);
+        assert_eq!(trailing_cup(b"plain"), None);
+    }
+
+    #[test]
+    fn origin_adds_a_top_status_line() {
+        assert_eq!(parse_origin("5 2 1\n"), Some((5, 3)));
+        assert_eq!(parse_origin("0 0 0"), Some((0, 0)));
+        assert_eq!(parse_origin("garbage"), None);
+    }
+
+    #[test]
+    fn each_chunk_and_delete_gets_its_own_envelope() {
+        let commands: &[&[u8]] = &[
+            b"\x1b_Ga=T,m=1;AAAA\x1b\\",
+            b"\x1b_Gm=0;AAAA\x1b\\",
+            b"\x1b_Ga=d,d=A,q=2\x1b\\",
+        ];
+        let mut expected = Vec::new();
+        for command in commands {
+            wrap(&mut expected, command).unwrap();
+        }
+        let mut output = Vec::new();
+        write_with_tmux(&mut output, &commands.concat(), true, (0, 0)).unwrap();
+        assert_eq!(output, expected);
+    }
+
+    #[test]
+    fn passthrough_escapes_every_embedded_escape() {
+        let mut output = Vec::new();
+        wrap(&mut output, b"\x1b_Ga=q;\x1bX\x1b\\").unwrap();
+        assert_eq!(output, b"\x1bPtmux;\x1b\x1b_Ga=q;\x1b\x1bX\x1b\x1b\\\x1b\\");
+    }
+
+    #[test]
+    fn sentinel_can_follow_the_outer_graphics_query() {
+        let mut output = Vec::new();
+        wrap(&mut output, b"\x1b[c").unwrap();
+        assert_eq!(output, b"\x1bPtmux;\x1b\x1b[c\x1b\\");
+    }
+}
