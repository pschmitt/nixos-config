diff --git a/src/auth/browser-daemon.ts b/src/auth/browser-daemon.ts
new file mode 100644
index 0000000..d581051
--- /dev/null
+++ b/src/auth/browser-daemon.ts
@@ -0,0 +1,239 @@
+/** Sign in from the user's existing Outlook session in browser-daemon. */
+
+import * as fs from 'node:fs';
+import { OWA_URL } from '../constants.js';
+import { extractTokensFromLocalStorage, getOwaLocalStorage, type StorageState } from './token-extractor.js';
+import { writeSessionState, writeTokenCache } from './session-store.js';
+import { logger } from '../utils/logger.js';
+
+const DEFAULT_SECRET_FILE = '/run/secrets/browser-daemon/cluster-secret';
+const REQUEST_TIMEOUT_MS = 30_000;
+const TOKEN_WAIT_MS = 40_000;
+const POLL_INTERVAL_MS = 2_000;
+const OWA_HOSTS = new Set(['outlook.cloud.microsoft', 'outlook.office.com', 'outlook.office365.com']);
+
+interface Profile {
+  name: string;
+  node_name: string;
+  node_url: string;
+  session_id?: string | null;
+}
+
+interface Overview {
+  local_node: { name: string };
+  profiles: Profile[];
+  targets: Array<{ id: string; type: string; url: string; sessionId?: string | null }>;
+}
+
+interface DaemonCookie {
+  name: string;
+  value: string;
+  domain: string;
+  path?: string;
+  expires?: number;
+  http_only?: boolean;
+  secure?: boolean;
+  same_site?: string;
+}
+
+interface LoginSnapshot {
+  url: string;
+  cookies: DaemonCookie[];
+  local_storage?: Record<string, string>;
+}
+
+function isOwaUrl(value: string): boolean {
+  try {
+    return OWA_HOSTS.has(new URL(value).hostname);
+  } catch {
+    return false;
+  }
+}
+
+function toStorageState(login: LoginSnapshot): StorageState {
+  const sameSite = { strict: 'Strict', lax: 'Lax', none: 'None' } as const;
+  return {
+    cookies: login.cookies.map(cookie => ({
+      name: cookie.name,
+      value: cookie.value,
+      domain: cookie.domain,
+      path: cookie.path ?? '/',
+      expires: typeof cookie.expires === 'number' && cookie.expires > 0 ? cookie.expires : -1,
+      httpOnly: cookie.http_only ?? false,
+      secure: cookie.secure ?? true,
+      sameSite: sameSite[(cookie.same_site ?? '').toLowerCase() as keyof typeof sameSite] ?? 'Lax',
+    })),
+    origins: [{
+      origin: new URL(login.url).origin,
+      localStorage: Object.entries(login.local_storage ?? {}).map(([name, value]) => ({ name, value })),
+    }],
+  };
+}
+
+function daemonConfig(): { url: string; profile: string } | null {
+  const url = process.env.MSOUTLOOK_BROWSER_DAEMON_URL;
+  if (!url) return null;
+  return {
+    url: url.replace(/\/+$/, ''),
+    profile: process.env.MSOUTLOOK_BROWSER_DAEMON_PROFILE || 'work',
+  };
+}
+
+async function discoverToken(base: string): Promise<string | undefined> {
+  for (const file of [process.env.BROWSER_DAEMON_SECRET_FILE, DEFAULT_SECRET_FILE]) {
+    if (!file) continue;
+    try {
+      const value = fs.readFileSync(file, 'utf8').trim();
+      if (value) return value;
+    } catch {
+      // Try the dashboard-issued cookie if the cluster secret is unavailable.
+    }
+  }
+
+  const res = await fetch(`${base}/`, { signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS) });
+  for (const cookie of res.headers.getSetCookie()) {
+    const match = /^bd_auth=([^;]+)/.exec(cookie);
+    if (match) return match[1];
+  }
+  return undefined;
+}
+
+class Mesh {
+  private constructor(private readonly base: string, private readonly token?: string) {}
+
+  static async connect(base: string): Promise<Mesh> {
+    return new Mesh(base, await discoverToken(base));
+  }
+
+  async request(method: string, url: string, body?: unknown): Promise<unknown> {
+    const res = await fetch(url, {
+      method,
+      headers: {
+        ...(this.token ? { 'X-Browser-Cluster-Secret': this.token } : {}),
+        ...(body === undefined ? {} : { 'Content-Type': 'application/json' }),
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+    if (!res.ok) throw new Error(`browser-daemon ${method} ${new URL(url).pathname}: HTTP ${res.status}`);
+    const text = await res.text();
+    try {
+      return text ? JSON.parse(text) : null;
+    } catch {
+      return text;
+    }
+  }
+
+  overview(): Promise<Overview> {
+    return this.request('GET', `${this.base}/api/mesh/overview`) as Promise<Overview>;
+  }
+
+  api(overview: Overview, node: string, path: string): string {
+    const prefix = node === overview.local_node.name ? '/api' : `/api/peers/${encodeURIComponent(node)}`;
+    return `${this.base}${prefix}${path}`;
+  }
+
+  devtools(overview: Overview, node: string, path: string): string {
+    const prefix = node === overview.local_node.name ? '' : `/api/peers/${encodeURIComponent(node)}`;
+    return `${this.base}${prefix}${path}`;
+  }
+}
+
+async function cacheSnapshot(snapshot: LoginSnapshot): Promise<string | null> {
+  const state = toStorageState(snapshot);
+  const localStorage = getOwaLocalStorage(state);
+  if (!localStorage) return null;
+  const tokens = await extractTokensFromLocalStorage(localStorage, state.cookies);
+  if (!tokens) return null;
+
+  writeSessionState(state);
+  writeTokenCache({
+    owaToken: tokens.owaToken,
+    owaTokenExpiry: tokens.owaTokenExpiry.getTime(),
+    graphToken: tokens.graphToken,
+    graphTokenExpiry: tokens.graphTokenExpiry?.getTime(),
+    refreshToken: tokens.refreshToken,
+    tenantId: tokens.tenantId,
+    upn: tokens.upn,
+    extractedAt: Date.now(),
+  });
+  return tokens.upn ?? 'unknown';
+}
+
+async function readPageLogin(mesh: Mesh, nodeUrl: string, pageId: string, sessionId: string): Promise<LoginSnapshot> {
+  return mesh.request('POST', `${nodeUrl.replace(/\/+$/, '')}/api/pages/${encodeURIComponent(pageId)}/auth`, {
+    session_id: sessionId,
+    urls: [],
+    storage: true,
+  }) as Promise<LoginSnapshot>;
+}
+
+/** Import the already signed-in Outlook page, without exposing its tokens to the MCP client. */
+export async function loginViaBrowserDaemon(): Promise<string> {
+  const config = daemonConfig();
+  if (!config) throw new Error('MSOUTLOOK_BROWSER_DAEMON_URL is not configured');
+
+  const mesh = await Mesh.connect(config.url);
+  const overview = await mesh.overview();
+  const profile = overview.profiles.find(item => item.name === config.profile);
+  if (!profile) throw new Error(`browser-daemon has no profile "${config.profile}"`);
+
+  const node = profile.node_name;
+  let sessionId = profile.session_id ?? undefined;
+  const startedSession = sessionId === undefined;
+  let pageId: string | undefined;
+  let openedPage = false;
+
+  try {
+    if (!sessionId) {
+      const created = await mesh.request('POST', mesh.api(overview, node, '/sessions'), {
+        persistent: true,
+        profile: config.profile,
+        default_tabs: false,
+        record: false,
+        idle_timeout_minutes: 5,
+      }) as { id?: string; session?: { id?: string } };
+      sessionId = created.id ?? created.session?.id;
+      if (!sessionId) throw new Error('browser-daemon did not return a session id');
+    } else {
+      pageId = overview.targets.find(target => target.sessionId === sessionId && target.type === 'page' && isOwaUrl(target.url))?.id;
+    }
+
+    if (!pageId) {
+      const opened = await mesh.request(
+        'PUT',
+        `${mesh.devtools(overview, node, '/json/new')}?url=${encodeURIComponent(OWA_URL)}&session_id=${sessionId}`,
+      ) as { id?: string };
+      pageId = opened.id;
+      openedPage = true;
+      if (!pageId) throw new Error('browser-daemon did not return a page id');
+    }
+
+    const deadline = Date.now() + TOKEN_WAIT_MS;
+    let lastUrl = '';
+    while (Date.now() < deadline) {
+      try {
+        const snapshot = await readPageLogin(mesh, profile.node_url, pageId, sessionId);
+        lastUrl = snapshot.url;
+        if (isOwaUrl(lastUrl)) {
+          const upn = await cacheSnapshot(snapshot);
+          if (upn) return upn;
+        }
+      } catch (error) {
+        logger.debug('browser-daemon login is still navigating', error instanceof Error ? error.message : String(error));
+      }
+      await new Promise(resolve => setTimeout(resolve, POLL_INTERVAL_MS));
+    }
+
+    const where = isOwaUrl(lastUrl) ? 'Outlook did not finish storing its login in time' : `the page ended on ${new URL(lastUrl || OWA_URL).hostname}`;
+    throw new Error(`browser-daemon profile is not signed in to Outlook (${where})`);
+  } finally {
+    try {
+      if (openedPage && pageId) await mesh.request('PUT', mesh.devtools(overview, node, `/json/close/${pageId}`));
+      if (startedSession && sessionId) await mesh.request('DELETE', mesh.api(overview, node, `/sessions/${sessionId}`));
+      else if (sessionId) await mesh.request('POST', mesh.api(overview, node, `/sessions/${sessionId}/idle-timeout?minutes=5`));
+    } catch (error) {
+      logger.warn('browser-daemon cleanup failed', error instanceof Error ? error.message : String(error));
+    }
+  }
+}
