+	// A syscall the handler itself reissued through the exempt stub can
+	// only have been trapped by another seccomp filter: Android's app
+	// filter, which traps what it does not allow (openat2 on Android 15).
+	// Translating and reissuing it again would recurse until the stack
+	// overflows. Fail it with ENOSYS, as a kernel without it would; libc
+	// and Nix fall back to the older syscalls.
+	uintptr_t pc = (uintptr_t)si->si_call_addr;
+	if (pc >= (uintptr_t)allow_start && pc <= (uintptr_t)allow_end) {
+		r[0] = (unsigned long)-ENOSYS;
+		return;
+	}
