+/**
+ * Imports a login exported from an already signed-in browser.
+ *
+ * Reads the JSON a browser-daemon `browser_export_auth format=json` call writes
+ * (cookies plus the requested localStorage entries) and turns it into the
+ * session state the browser login would have saved. Exports hold live
+ * credentials, so only a private file owned by the current user inside
+ * $XDG_RUNTIME_DIR is accepted.
+ */
+
+import * as fs from 'fs';
+import * as path from 'path';
+import type { SessionState } from './session-store.js';
+
+/** A cookie as written by the browser export. */
+interface ExportedCookie {
+  name: string;
+  value: string;
+  domain: string;
+  path?: string;
+  expires?: number;
+  http_only?: boolean;
+  secure?: boolean;
+  same_site?: string;
+}
+
+/** The export file: cookies and local storage of one page. */
+export interface BrowserExport {
+  url: string;
+  cookies: ExportedCookie[];
+  storage: Record<string, string> | null;
+}
+
+const SAME_SITE: Record<string, 'Strict' | 'Lax' | 'None'> = {
+  strict: 'Strict',
+  lax: 'Lax',
+  none: 'None',
+};
+
+/**
+ * Reads an export file after checking where it is and who can read it.
+ * Never includes file content in an error message.
+ *
+ * @throws Error if the file is not a private export of the current user
+ */
+export function readBrowserExport(file: string): BrowserExport {
+  const runtimeDir = process.env.XDG_RUNTIME_DIR;
+  if (!runtimeDir) {
+    throw new Error('XDG_RUNTIME_DIR is not set; cannot locate browser exports.');
+  }
+
+  const resolved = fs.realpathSync(file);
+  const allowedDir = fs.realpathSync(runtimeDir) + path.sep;
+  if (!resolved.startsWith(allowedDir)) {
+    throw new Error(`The export must be a file below ${allowedDir}`);
+  }
+
+  const stats = fs.statSync(resolved);
+  if (!stats.isFile()) {
+    throw new Error('The export is not a regular file.');
+  }
+  if (stats.uid !== process.getuid?.() || (stats.mode & 0o077) !== 0) {
+    throw new Error('The export must be owned by the current user and not readable by others.');
+  }
+
+  let data: Partial<BrowserExport>;
+  try {
+    data = JSON.parse(fs.readFileSync(resolved, 'utf8')) as Partial<BrowserExport>;
+  } catch {
+    // JSON.parse errors can quote the text; the file holds credentials
+    throw new Error('The export is not valid JSON.');
+  }
+  if (typeof data.url !== 'string' || !Array.isArray(data.cookies)) {
+    throw new Error('Not a browser export in json format.');
+  }
+  if (!data.storage || Object.keys(data.storage).length === 0) {
+    throw new Error('The export has no local storage; request the MSAL and tmp.auth keys with storage_keys.');
+  }
+  return data as BrowserExport;
+}
+
+/** Builds a session state (Playwright storage state) from an export. */
+export function sessionStateFromExport(data: BrowserExport): SessionState {
+  return {
+    cookies: data.cookies.map(cookie => ({
+      name: cookie.name,
+      value: cookie.value,
+      domain: cookie.domain,
+      path: cookie.path ?? '/',
+      expires: typeof cookie.expires === 'number' && cookie.expires > 0 ? cookie.expires : -1,
+      httpOnly: cookie.http_only ?? false,
+      secure: cookie.secure ?? true,
+      sameSite: SAME_SITE[(cookie.same_site ?? '').toLowerCase()] ?? 'Lax',
+    })),
+    origins: [{
+      origin: new URL(data.url).origin,
+      localStorage: Object.entries(data.storage ?? {}).map(([name, value]) => ({ name, value })),
+    }],
+  };
+}
