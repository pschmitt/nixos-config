+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { readBrowserExport, sessionStateFromExport } from './browser-export.js';
+
+describe('browser export import', () => {
+  let runtimeDir: string;
+  let previousRuntimeDir: string | undefined;
+
+  beforeEach(() => {
+    previousRuntimeDir = process.env.XDG_RUNTIME_DIR;
+    runtimeDir = fs.mkdtempSync(path.join(os.tmpdir(), 'msteams-export-'));
+    process.env.XDG_RUNTIME_DIR = runtimeDir;
+  });
+
+  afterEach(() => {
+    if (previousRuntimeDir === undefined) delete process.env.XDG_RUNTIME_DIR;
+    else process.env.XDG_RUNTIME_DIR = previousRuntimeDir;
+    fs.rmSync(runtimeDir, { recursive: true, force: true });
+  });
+
+  function writeExport(content: unknown, mode = 0o600): string {
+    const file = path.join(runtimeDir, 'login.json');
+    fs.writeFileSync(file, typeof content === 'string' ? content : JSON.stringify(content), { mode });
+    fs.chmodSync(file, mode);
+    return file;
+  }
+
+  const exported = {
+    url: 'https://teams.cloud.microsoft/v2/',
+    cookies: [{ name: 'a', value: 'b', domain: 'teams.cloud.microsoft', path: '/', expires: 0, http_only: true, secure: true, same_site: 'none' }],
+    storage: { 'msal.2|x': '{"secret":"s"}' },
+  };
+
+  it('converts an export to a session state', () => {
+    const state = sessionStateFromExport(readBrowserExport(writeExport(exported)));
+    expect(state.origins).toEqual([{
+      origin: 'https://teams.cloud.microsoft',
+      localStorage: [{ name: 'msal.2|x', value: '{"secret":"s"}' }],
+    }]);
+    expect(state.cookies[0]).toMatchObject({ httpOnly: true, sameSite: 'None', expires: -1 });
+  });
+
+  it('rejects files readable by others', () => {
+    expect(() => readBrowserExport(writeExport(exported, 0o644))).toThrow(/not readable by others/);
+  });
+
+  it('rejects files outside the runtime directory', () => {
+    const outside = path.join(os.tmpdir(), `msteams-outside-${process.pid}.json`);
+    fs.writeFileSync(outside, JSON.stringify(exported), { mode: 0o600 });
+    try {
+      expect(() => readBrowserExport(outside)).toThrow(/below/);
+    } finally {
+      fs.rmSync(outside, { force: true });
+    }
+  });
+
+  it('rejects an export without local storage', () => {
+    expect(() => readBrowserExport(writeExport({ ...exported, storage: null }))).toThrow(/no local storage/);
+  });
+
+  it('does not quote file content when it is not JSON', () => {
+    expect(() => readBrowserExport(writeExport('secret-value'))).toThrow('The export is not valid JSON.');
+  });
+});
