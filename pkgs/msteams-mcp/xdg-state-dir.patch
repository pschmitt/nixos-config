 import * as fs from 'fs';
@@ -18,13 +19,29 @@ import { SESSION_EXPIRY_HOURS, TEAMS_HOSTS } from '../constants.js';
 import * as log from '../utils/logger.js';
 
 /**
- * User-specific config directory for teams-mcp-server.
+ * User-specific state directory for teams-mcp-server. Logins are tokens that
+ * expire and cannot be moved between machines, so they are state, not config.
  * - Windows: %APPDATA%\teams-mcp-server\
- * - macOS/Linux: ~/.teams-mcp-server/
