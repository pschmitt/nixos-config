+  : path.join(process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state'), 'teams-mcp-server');
+
+/** Directory earlier versions used on macOS/Linux. */
+const LEGACY_CONFIG_DIR = path.join(os.homedir(), '.teams-mcp-server');
+
+/** Moves the legacy directory to CONFIG_DIR once, keeping the existing login. */
+function migrateLegacyConfigDir(): void {
+  try {
+    if (process.platform === 'win32' || !fs.existsSync(LEGACY_CONFIG_DIR) || fs.existsSync(CONFIG_DIR)) return;
+    fs.mkdirSync(path.dirname(CONFIG_DIR), { recursive: true });
+    fs.renameSync(LEGACY_CONFIG_DIR, CONFIG_DIR);
+  } catch {
+    // Leave the legacy directory alone; the next login creates a fresh one
+  }
+}
+migrateLegacyConfigDir();
 export const SESSION_STATE_PATH = path.join(CONFIG_DIR, 'session-state.json');
