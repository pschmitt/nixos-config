+  try {
+    writeSessionState(await loginViaBrowserDaemon(config));
+    clearTokenCache();
+    await refreshTokensViaHttp();
+    if (!extractSubstrateToken()) {
+      throw new Error('its login holds no usable Substrate token');
+    }
+    return ok(undefined);
+  } catch (error) {
