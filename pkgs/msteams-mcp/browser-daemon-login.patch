+++ b/src/auth/browser-daemon.test.ts
@@ -0,0 +1,109 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { browserDaemonConfig, loginViaBrowserDaemon } from './browser-daemon.js';
+
+const NODE_URL = 'https://browser.fnuc.example';
+const BASE = 'https://browser.rofl.example';
+
+/** An unsigned JWT that expires in an hour. */
+function jwt(): string {
+  const encode = (value: object) => Buffer.from(JSON.stringify(value)).toString('base64url');
+  return `${encode({ alg: 'none' })}.${encode({ exp: Math.floor(Date.now() / 1000) + 3600 })}.sig`;
+}
+
+const loggedInStorage = {
+  access: JSON.stringify({ credentialType: 'AccessToken', target: 'substrate.office.com/SubstrateSearch-Internal.ReadWrite', secret: jwt() }),
+  refresh: JSON.stringify({ credentialType: 'RefreshToken', secret: 'refresh', clientId: 'client' }),
+};
+
+interface MeshOptions {
+  activeSession?: string;
+  pageUrl?: string;
+}
+
+/** A fake mesh: records every request and answers like a browser-daemon node. */
+function fakeMesh({ activeSession, pageUrl = 'https://teams.cloud.microsoft/v2/' }: MeshOptions = {}) {
+  const calls: string[] = [];
+  const json = (body: unknown) => new Response(JSON.stringify(body), { status: 200 });
+
+  vi.stubGlobal('fetch', vi.fn(async (input: string, init?: RequestInit) => {
+    const url = new URL(input);
+    const call = `${init?.method ?? 'GET'} ${url.pathname}`;
+    calls.push(call);
+
+    if (call === 'GET /') return new Response('', { headers: { 'set-cookie': 'bd_auth=token; Path=/' } });
+    if (call === 'GET /api/mesh/overview') {
+      return json({
+        local_node: { name: 'rofl' },
+        profiles: [{ name: 'work', node_name: 'fnuc', node_url: NODE_URL, session_id: activeSession ?? null }],
+        targets: activeSession
+          ? [{ id: 'existing-page', type: 'page', url: 'https://teams.cloud.microsoft/', sessionId: activeSession }]
+          : [],
+      });
+    }
+    if (call === 'POST /api/peers/fnuc/sessions') return json({ id: 'new-session' });
+    if (call === 'PUT /api/peers/fnuc/json/new') return json({ id: 'new-page' });
+    if (url.pathname.endsWith('/auth')) {
+      return json({ url: pageUrl, cookies: [], local_storage: loggedInStorage });
+    }
+    return new Response('Target is closing', { status: 200 });
+  }));
+  return calls;
+}
+
+describe('browser-daemon login', () => {
+  beforeEach(() => {
+    vi.stubEnv('TEAMS_MCP_BROWSER_DAEMON_URL', BASE);
+    vi.stubEnv('BROWSER_DAEMON_SECRET_FILE', '/nonexistent');
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    vi.unstubAllGlobals();
+  });
+
+  it('is off without a configured daemon', () => {
+    vi.stubEnv('TEAMS_MCP_BROWSER_DAEMON_URL', '');
+    expect(browserDaemonConfig()).toBeNull();
+  });
+
+  it('defaults to the work profile', () => {
+    expect(browserDaemonConfig()).toEqual({ url: BASE, profile: 'work' });
+  });
+
+  it('starts a session, reads the login and stops the session', async () => {
+    const calls = fakeMesh();
+    const state = await loginViaBrowserDaemon({ url: BASE, profile: 'work' });
+
+    expect(state.origins[0].origin).toBe('https://teams.cloud.microsoft');
+    expect(state.origins[0].localStorage).toHaveLength(2);
+    expect(calls).toContain('POST /api/peers/fnuc/sessions');
+    expect(calls).toContain('POST /api/pages/new-page/auth');
+    expect(calls).toContain('DELETE /api/peers/fnuc/sessions/new-session');
+  });
+
+  it('reuses a running session and leaves it and its Teams tab alone', async () => {
+    const calls = fakeMesh({ activeSession: 'busy' });
+    await loginViaBrowserDaemon({ url: BASE, profile: 'work' });
+
+    expect(calls).toContain('POST /api/pages/existing-page/auth');
+    expect(calls.filter(c => c.startsWith('DELETE') || c.includes('/json/'))).toEqual([]);
+  });
+
+  it('rejects an unknown profile', async () => {
+    fakeMesh();
+    await expect(loginViaBrowserDaemon({ url: BASE, profile: 'other' })).rejects.toThrow('no profile "other"');
+  });
+
+  it('reports a profile that is not signed in', async () => {
+    vi.useFakeTimers();
+    try {
+      fakeMesh({ pageUrl: 'https://login.microsoftonline.com/common/oauth2' });
+      const login = loginViaBrowserDaemon({ url: BASE, profile: 'work' });
+      const assertion = expect(login).rejects.toThrow('not signed in to Teams (the page ended on login.microsoftonline.com)');
+      await vi.advanceTimersByTimeAsync(60_000);
+      await assertion;
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
