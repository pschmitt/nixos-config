+++ b/src/auth/browser-daemon.ts
@@ -0,0 +1,280 @@
+/**
+ * Signs in with the Teams login of a browser-daemon profile.
+ *
+ * A browser-daemon (https://github.com/pschmitt/browser-daemon) node can keep a
+ * profile that is already signed in to Teams. This asks the mesh for that
+ * profile, reads the Teams page's cookies and local storage through the node's
+ * own API and turns them into a session state, so no browser has to start on
+ * this machine. The login travels only between this process and the node.
+ *
+ * Enabled by TEAMS_MCP_BROWSER_DAEMON_URL (any node of the mesh). Optional:
+ * TEAMS_MCP_BROWSER_DAEMON_PROFILE (default "work"), BROWSER_DAEMON_SECRET_FILE.
+ * Without a cluster secret, the sign-in token the node's dashboard hands out
+ * is used, as the browser-daemon CLI does.
+ */
+
+import * as fs from 'fs';
+import { extractSubstrateToken } from './token-extractor.js';
+import type { SessionState } from './session-store.js';
+import { TEAMS_HOSTS } from '../constants.js';
+import * as log from '../utils/logger.js';
+
+/** Page that opens Teams (it may redirect to another Teams host). */
+const TEAMS_URL = 'https://teams.microsoft.com/v2/';
+
+/** Where the NixOS module of the browser-daemon puts the cluster secret. */
+const DEFAULT_SECRET_FILE = '/run/secrets/browser-daemon/cluster-secret';
+
+/** Teams stores its tokens within seconds; stay below the 60 s MCP client timeout. */
+const TOKEN_WAIT_MS = 40_000;
+const POLL_INTERVAL_MS = 3_000;
+const REQUEST_TIMEOUT_MS = 30_000;
+
+/** A cookie as the browser-daemon API returns it. */
+interface DaemonCookie {
+  name: string;
+  value: string;
+  domain: string;
+  path?: string;
+  expires?: number;
+  http_only?: boolean;
+  secure?: boolean;
+  same_site?: string;
+}
+
+const SAME_SITE: Record<string, 'Strict' | 'Lax' | 'None'> = { strict: 'Strict', lax: 'Lax', none: 'None' };
+
+/** Turns a page login (cookies and local storage) into a session state. */
+function toSessionState(login: { url: string; cookies: DaemonCookie[]; local_storage: Record<string, string> }): SessionState {
+  return {
+    cookies: login.cookies.map(cookie => ({
+      name: cookie.name,
+      value: cookie.value,
+      domain: cookie.domain,
+      path: cookie.path ?? '/',
+      expires: typeof cookie.expires === 'number' && cookie.expires > 0 ? cookie.expires : -1,
+      httpOnly: cookie.http_only ?? false,
+      secure: cookie.secure ?? true,
+      sameSite: SAME_SITE[(cookie.same_site ?? '').toLowerCase()] ?? 'Lax',
+    })),
+    origins: [{
+      origin: new URL(login.url).origin,
+      localStorage: Object.entries(login.local_storage).map(([name, value]) => ({ name, value })),
+    }],
+  };
+}
+
+export interface BrowserDaemonConfig {
+  url: string;
+  profile: string;
+}
+
+/** The configured daemon, or null when this feature is off. */
+export function browserDaemonConfig(): BrowserDaemonConfig | null {
+  const url = process.env.TEAMS_MCP_BROWSER_DAEMON_URL;
+  if (!url) return null;
+  return {
+    url: url.replace(/\/+$/, ''),
+    profile: process.env.TEAMS_MCP_BROWSER_DAEMON_PROFILE || 'work',
+  };
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Mesh API
+// ─────────────────────────────────────────────────────────────────────────────
+
+interface MeshOverview {
+  local_node: { name: string };
+  profiles: Array<{ name: string; node_name: string; node_url: string; session_id?: string | null }>;
+  targets: Array<{ id: string; type: string; url: string; sessionId?: string | null }>;
+}
+
+/** The cluster secret from its file, else the token the dashboard hands out. */
+async function findToken(base: string): Promise<string | undefined> {
+  for (const file of [process.env.BROWSER_DAEMON_SECRET_FILE, DEFAULT_SECRET_FILE]) {
+    if (!file) continue;
+    try {
+      const secret = fs.readFileSync(file, 'utf8').trim();
+      if (secret) return secret;
+    } catch {
+      // Not readable by this user; try the next source
+    }
+  }
+
+  const res = await fetch(`${base}/`, { signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS) });
+  for (const cookie of res.headers.getSetCookie()) {
+    const match = /^bd_auth=([^;]+)/.exec(cookie);
+    if (match) return match[1];
+  }
+  return undefined;
+}
+
+class Mesh {
+  private constructor(private readonly base: string, private readonly token: string | undefined) {}
+
+  static async connect(base: string): Promise<Mesh> {
+    return new Mesh(base, await findToken(base));
+  }
+
+  /** Sends a request to `url`; never includes a response body in an error. */
+  async request(method: string, url: string, body?: unknown): Promise<unknown> {
+    const res = await fetch(url, {
+      method,
+      headers: {
+        ...(this.token ? { 'X-Browser-Cluster-Secret': this.token } : {}),
+        ...(body === undefined ? {} : { 'Content-Type': 'application/json' }),
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+    if (!res.ok) {
+      throw new Error(`browser-daemon ${method} ${new URL(url).pathname} answered HTTP ${res.status}`);
+    }
+    const text = await res.text();
+    try {
+      return text ? JSON.parse(text) : null;
+    } catch {
+      return text; // e.g. DevTools answers "Target is closing" as plain text
+    }
+  }
+
+  overview(): Promise<MeshOverview> {
+    return this.request('GET', `${this.base}/api/mesh/overview`) as Promise<MeshOverview>;
+  }
+
+  /** Routes a management path (`/sessions`) to `node`. */
+  api(overview: MeshOverview, node: string, path: string): string {
+    const prefix = node === overview.local_node.name ? '/api' : `/api/peers/${encodeURIComponent(node)}`;
+    return `${this.base}${prefix}${path}`;
+  }
+
+  /** Routes a DevTools path (`/json/new`) to `node`. */
+  devtools(overview: MeshOverview, node: string, path: string): string {
+    const prefix = node === overview.local_node.name ? '' : `/api/peers/${encodeURIComponent(node)}`;
+    return `${this.base}${prefix}${path}`;
+  }
+}
+
+const isTeamsHost = (url: string | undefined): boolean => {
+  try {
+    return url !== undefined && TEAMS_HOSTS.includes(new URL(url).host);
+  } catch {
+    return false;
+  }
+};
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Login
+// ─────────────────────────────────────────────────────────────────────────────
+
+/**
+ * Reads the Teams login of the configured profile.
+ *
+ * Reuses a running session of the profile (and its Teams tab) when there is
+ * one; otherwise starts a session, opens Teams and stops the session again.
+ *
+ * @throws Error if the daemon is unreachable, the profile does not exist, or
+ *   it is not signed in to Teams (the message says which)
+ */
+export async function loginViaBrowserDaemon(config: BrowserDaemonConfig): Promise<SessionState> {
+  const mesh = await Mesh.connect(config.url);
+  const overview = await mesh.overview();
+
+  const profile = overview.profiles.find(p => p.name === config.profile);
+  if (!profile) {
+    throw new Error(`browser-daemon has no profile "${config.profile}"`);
+  }
+  const node = profile.node_name;
+
+  let sessionId = profile.session_id ?? undefined;
+  const startedSession = sessionId === undefined;
+  let pageId: string | undefined;
+  let openedPage = false;
+
+  try {
+    if (sessionId === undefined) {
+      log.info('browser-daemon', `Starting a session of profile "${config.profile}" on ${node}`);
+      const created = await mesh.request('POST', mesh.api(overview, node, '/sessions'), {
+        persistent: true,
+        profile: config.profile,
+        default_tabs: false,
+        record: false,
+        idle_timeout_minutes: 5,
+      }) as { id?: string; session?: { id?: string } };
+      sessionId = created.id ?? created.session?.id;
+      if (!sessionId) throw new Error('browser-daemon did not return a session id');
+    } else {
+      pageId = overview.targets.find(t => t.sessionId === sessionId && t.type === 'page' && isTeamsHost(t.url))?.id;
+    }
+
+    if (!pageId) {
+      const opened = await mesh.request(
+        'PUT',
+        `${mesh.devtools(overview, node, '/json/new')}?url=${encodeURIComponent(TEAMS_URL)}&session_id=${sessionId}`,
+      ) as { id?: string };
+      pageId = opened.id;
+      openedPage = true;
+      if (!pageId) throw new Error('browser-daemon did not return a page id');
+    }
+
+    return await waitForLogin(mesh, profile.node_url, pageId, sessionId);
+  } finally {
+    // Best effort: a failure to clean up must not hide the login or its error
+    try {
+      if (startedSession && sessionId) {
+        await mesh.request('DELETE', mesh.api(overview, node, `/sessions/${sessionId}`));
+      } else if (openedPage && pageId) {
+        await mesh.request('PUT', mesh.devtools(overview, node, `/json/close/${pageId}`));
+      }
+    } catch (error) {
+      log.warn('browser-daemon', `Cleanup failed: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+}
+
+/**
+ * True once the MSAL cache holds a usable refresh token (Teams may store it
+ * after the access tokens). The HTTP refresh derives the messaging credentials
+ * from it, so the export need not hold them.
+ */
+function hasRefreshToken(state: SessionState): boolean {
+  return state.origins.some(origin => origin.localStorage.some(item => {
+    try {
+      const entry = JSON.parse(item.value) as { credentialType?: string; secret?: string; clientId?: string };
+      return entry.credentialType === 'RefreshToken' && !!entry.secret && !!entry.clientId;
+    } catch {
+      return false;
+    }
+  }));
+}
+
+/** Polls the page until Teams has stored everything a session needs. */
+async function waitForLogin(mesh: Mesh, nodeUrl: string, pageId: string, sessionId: string): Promise<SessionState> {
+  const deadline = Date.now() + TOKEN_WAIT_MS;
+  let lastUrl = '';
+
+  for (;;) {
+    try {
+      const login = await mesh.request('POST', `${nodeUrl.replace(/\/+$/, '')}/api/pages/${encodeURIComponent(pageId)}/auth`, {
+        session_id: sessionId,
+        urls: [],
+        storage: true,
+      }) as { url: string; cookies: DaemonCookie[]; local_storage?: Record<string, string> };
+
+      lastUrl = login.url;
+      if (isTeamsHost(login.url) && login.local_storage) {
+        const state = toSessionState({ url: login.url, cookies: login.cookies, local_storage: login.local_storage });
+        if (extractSubstrateToken(state) && hasRefreshToken(state)) return state;
+      }
+    } catch (error) {
+      // The page may still be navigating; retry until the deadline
+      log.debug('browser-daemon', error instanceof Error ? error.message : String(error));
+    }
+
+    if (Date.now() >= deadline) {
+      const where = isTeamsHost(lastUrl) ? 'Teams did not finish storing its login in time' : `the page ended on ${new URL(lastUrl || TEAMS_URL).host}`;
+      throw new Error(`The browser-daemon profile is not signed in to Teams (${where})`);
+    }
+    await new Promise(resolve => setTimeout(resolve, POLL_INTERVAL_MS));
+  }
+}
