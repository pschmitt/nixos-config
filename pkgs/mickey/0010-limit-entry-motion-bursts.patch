+
+/// The receiver can get several fresh reports at once while the compositor
+/// is showing the cursor at the entry edge. Bound their total travel for
+/// the first frame without delaying normal motion or replaying the excess.
+struct EntryMotion {
+    started: Instant,
+    used: i64,
+}
+
+impl EntryMotion {
+    const WINDOW: Duration = Duration::from_millis(20);
+
+    fn new(now: Instant) -> Self {
+        Self {
+            started: now,
+            used: 0,
+        }
+    }
+
+    fn limit(&mut self, now: Instant, dx: i32, dy: i32) -> (i32, i32) {
+        let elapsed = now.saturating_duration_since(self.started);
+        if elapsed >= Self::WINDOW {
+            return (dx, dy);
+        }
+        let distance = i64::from(dx).abs().max(i64::from(dy).abs());
+        let budget = 4 + (elapsed.as_micros() / 500) as i64 - self.used;
+        self.used += distance.min(budget);
+        if distance <= budget {
+            return (dx, dy);
+        }
+        (
+            (i64::from(dx) * budget / distance) as i32,
+            (i64::from(dy) * budget / distance) as i32,
+        )
+    }
 }
 
