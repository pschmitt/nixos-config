+    /// Whether the open device is still the node at this path. Linux can reuse
+    /// the event number after unplugging, so compare the underlying inodes.
+    pub fn still_at(&self, path: &Path) -> bool {
+        use std::os::unix::fs::MetadataExt;
+        self.file
+            .metadata()
+            .ok()
+            .zip(path.metadata().ok())
+            .is_some_and(|(opened, current)| {
+                opened.dev() == current.dev() && opened.ino() == current.ino()
+            })
+    }
