diff --git a/crates/mickey-config/src/address.rs b/crates/mickey-config/src/address.rs
new file mode 100644
index 0000000..52de694
--- /dev/null
+++ b/crates/mickey-config/src/address.rs
@@ -0,0 +1,139 @@
+use serde::Deserialize;
+use std::fmt;
+use std::io;
+use std::net::{IpAddr, SocketAddr, ToSocketAddrs};
+use std::str::FromStr;
+
+/// A peer endpoint as written by the user. DNS is resolved by the caller
+/// when dialing, so a VPN can become available after Mickey starts.
+#[derive(Clone, Debug, Deserialize, Eq, Hash, PartialEq)]
+#[serde(try_from = "String")]
+pub enum PeerAddress {
+    Ip(SocketAddr),
+    Host { name: String, port: u16 },
+}
+
+impl PeerAddress {
+    pub fn port(&self) -> u16 {
+        match self {
+            Self::Ip(address) => address.port(),
+            Self::Host { port, .. } => *port,
+        }
+    }
+
+    pub fn numeric(&self) -> Option<SocketAddr> {
+        match self {
+            Self::Ip(address) => Some(*address),
+            Self::Host { .. } => None,
+        }
+    }
+
+    pub fn resolve(&self) -> io::Result<Vec<SocketAddr>> {
+        match self {
+            Self::Ip(address) => Ok(vec![*address]),
+            Self::Host { name, port } => Ok((name.as_str(), *port).to_socket_addrs()?.collect()),
+        }
+    }
+
+    pub fn matches_ip(&self, ip: IpAddr) -> bool {
+        self.resolve()
+            .is_ok_and(|addresses| addresses.iter().any(|address| address.ip() == ip))
+    }
+}
+
+impl fmt::Display for PeerAddress {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Ip(address) => address.fmt(f),
+            Self::Host { name, port } => write!(f, "{name}:{port}"),
+        }
+    }
+}
+
+impl From<SocketAddr> for PeerAddress {
+    fn from(address: SocketAddr) -> Self {
+        Self::Ip(address)
+    }
+}
+
+impl TryFrom<String> for PeerAddress {
+    type Error = String;
+
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        value.parse()
+    }
+}
+
+impl FromStr for PeerAddress {
+    type Err = String;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        if let Ok(address) = value.parse::<SocketAddr>() {
+            return Ok(address.into());
+        }
+        let invalid =
+            || format!("expected an IP address or DNS hostname with a port, got {value:?}");
+        let (name, port) = value.rsplit_once(':').ok_or_else(invalid)?;
+        let labels = name.strip_suffix('.').unwrap_or(name);
+        if labels.len() > 253
+            || !labels.split('.').all(|label| {
+                !label.is_empty()
+                    && label.len() <= 63
+                    && !label.starts_with('-')
+                    && !label.ends_with('-')
+                    && label
+                        .bytes()
+                        .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+            })
+        {
+            return Err(invalid());
+        }
+        Ok(Self::Host {
+            name: name.into(),
+            port: port.parse().map_err(|_| invalid())?,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_dns_without_resolving_it() {
+        let config =
+            crate::parse("[[peer]]\nname = \"Desk\"\naddress = \"desk.invalid:4242\"\n").unwrap();
+        assert_eq!(config.peers[0].address.to_string(), "desk.invalid:4242");
+        assert_eq!(config.peers[0].address.numeric(), None);
+    }
+
+    #[test]
+    fn accepts_numeric_addresses_and_resolves_a_hostname() {
+        for endpoint in ["192.0.2.1:4242", "[::1]:4242"] {
+            let parsed: PeerAddress = endpoint.parse().unwrap();
+            assert_eq!(parsed.numeric(), Some(endpoint.parse().unwrap()));
+        }
+        let endpoint: PeerAddress = "localhost:4242".parse().unwrap();
+        let addresses = endpoint.resolve().unwrap();
+        assert!(!addresses.is_empty());
+        assert!(
+            addresses
+                .iter()
+                .all(|address| address.ip().is_loopback() && address.port() == 4242)
+        );
+    }
+
+    #[test]
+    fn rejects_addresses_without_a_valid_host_and_port() {
+        for invalid in [
+            "desk",
+            "desk:70000",
+            "a..b:4242",
+            "a/b:4242",
+            "::1:4242",
+            "-desk:4242",
+        ] {
+            assert!(invalid.parse::<PeerAddress>().is_err(), "{invalid}");
+        }
+    }
+}
