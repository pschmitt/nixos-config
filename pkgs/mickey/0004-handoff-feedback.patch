diff --git a/crates/mickey/src/handoff.rs b/crates/mickey/src/handoff.rs
new file mode 100644
--- /dev/null
+++ b/crates/mickey/src/handoff.rs
@@ -0,0 +1,39 @@
+//! Optional desktop feedback. The capture and transport loops only enqueue
+//! coordinates; slow or unavailable feedback never holds up the handoff.
+use std::sync::OnceLock;
+use std::sync::mpsc::{self, SyncSender};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+type Event = (&'static str, (i32, i32));
+static EVENTS: OnceLock<SyncSender<Event>> = OnceLock::new();
+
+pub fn start() {
+    let Some(path) = std::env::var_os("MICKEY_HANDOFF_FILE") else {
+        return;
+    };
+    let path = std::path::PathBuf::from(path);
+    let temporary = path.with_extension(format!("{}.tmp", std::process::id()));
+    let (sender, receiver) = mpsc::sync_channel::<Event>(4);
+    if EVENTS.set(sender).is_err() {
+        return;
+    }
+    crate::threads::spawn("handoff effect", move || {
+        for (sequence, (kind, (x, y))) in receiver.into_iter().enumerate() {
+            let time = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis();
+            let value = serde_json::json!({ "kind": kind, "x": x, "y": y,
+                "time": time, "sequence": sequence });
+            if std::fs::write(&temporary, value.to_string()).is_ok() {
+                let _ = std::fs::rename(&temporary, &path);
+            }
+        }
+    });
+}
+
+pub fn show(kind: &'static str, point: (i32, i32)) {
+    if let Some(events) = EVENTS.get() {
+        let _ = events.try_send((kind, point));
+    }
+}
