{
  lib,
  config,
  pkgs,
  ...
}:
let
  cfg = config.services.ppd-react;

  profileVariable =
    profile: "TDP_PROFILE_${lib.toUpper (lib.replaceStrings [ "-" ] [ "_" ] profile)}";
  batteryProfileVariable =
    profile: "TDP_BATTERY_PROFILE_${lib.toUpper (lib.replaceStrings [ "-" ] [ "_" ] profile)}";

  profileLimits = profile: lib.concatStringsSep " " (map toString (lib.replicate 4 (profile * 1000)));

  ppdReactConfig = pkgs.writeText "ppd-react.conf" (
    lib.concatStringsSep "\n" (
      [
        "# Generated by NixOS; configure services.ppd-react in Nix instead."
      ]
      ++ [
        "SYSTEM_UNITS_STOP_ON_POWER_SAVER=(${lib.escapeShellArgs cfg.stopSystemdUnitsOnPowerSaver})"
        "SYSTEM_UNITS_RESUME_ON_POWER_SAVER_EXIT=(${lib.escapeShellArgs cfg.resumeSystemdUnitsOnPowerSaverExit})"
        "USER_UNITS_STOP_ON_POWER_SAVER=(${lib.escapeShellArgs cfg.stopUserSystemdUnitsOnPowerSaver})"
        "USER_UNITS_RESUME_ON_POWER_SAVER_EXIT=(${lib.escapeShellArgs cfg.resumeUserSystemdUnitsOnPowerSaverExit})"
        "ONLY_STOP_UNITS_ON_BATTERY=${if cfg.onlyStopUnitsOnBattery then "1" else ""}"
        "NOTIFY=${if cfg.notify then "1" else ""}"
      ]
      ++ lib.optional (
        cfg.tdp.enable && cfg.tdp.command != null
      ) "TDP_COMMAND=${lib.escapeShellArg (toString cfg.tdp.command)}"
      ++ [
        "BATTERY_BRIGHTNESS_PERCENT=${toString cfg.defaults.brightness}"
        "CONNECTED_MINIMUM_BRIGHTNESS_PERCENT=${toString cfg.defaults.connectedMinimumBrightness}"
      ]
      ++ lib.concatLists (
        lib.mapAttrsToList (
          name: profile:
          let
            key = lib.toUpper (lib.replaceStrings [ "-" ] [ "_" ] name);
          in
          lib.optional (profile.brightness != null) "BRIGHTNESS_BATTERY_${key}=${toString profile.brightness}"
          ++ lib.optional (
            profile.connectedMinimumBrightness != null
          ) "BRIGHTNESS_CONNECTED_${key}=${toString profile.connectedMinimumBrightness}"
          ++ lib.optional (
            profile.tdp != null
          ) "${profileVariable name}=${lib.escapeShellArg (profileLimits profile.tdp)}"
          ++ lib.optional (
            profile.batteryTdp != null
          ) "${batteryProfileVariable name}=${lib.escapeShellArg (profileLimits profile.batteryTdp)}"
        ) cfg.profiles
      )
    )
    + "\n"
  );

  ppdReact = pkgs.writeShellApplication {
    name = "ppd-react";
    runtimeInputs = with pkgs; [
      brightnessctl
      coreutils
      gawk
      jq
      libnotify
      systemd
      util-linux
    ];
    text = builtins.readFile ./ppd-react.sh;
  };
in
{
  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = !cfg.tdp.enable || cfg.tdp.command != null;
        message = "services.ppd-react.tdp.command must be set when TDP integration is enabled";
      }
    ];

    # power-profiles-daemon conflicts with tlp
    # https://linrunner.de/tlp/faq/ppd.html
    services = {
      power-profiles-daemon.enable = lib.mkForce true;
      tlp.enable = lib.mkForce false;
    };

    systemd.services.ppd-react = {
      description = "React to power-profiles-daemon profile changes";
      # Start as part of power-profiles-daemon, after it has initialized its
      # current profile. This avoids the multi-user ordering cycle and makes
      # the initial TDP apply happen before user-session widgets read it.
      wantedBy = [ "power-profiles-daemon.service" ];
      after = [
        "dbus.service"
        "power-profiles-daemon.service"
        "syncthing-init.service"
      ];
      serviceConfig = {
        ExecStart = "${ppdReact}/bin/ppd-react --config=${ppdReactConfig}";
        RuntimeDirectory = "ppd-react";
        RuntimeDirectoryPreserve = "restart";
        Restart = "always";
        RestartSec = "1s";
      };
    };
  };
}
