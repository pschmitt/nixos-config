# The private etc/nixpp/setup.conf of a TermuxPP bootstrap: the defaults of
# `nixpp setup` (termuxpp pkgs/nixpp/source/README.md). The values come from
# nixos-config-private (lib.termuxppSetup), the controller's host key from its
# data/ssh-hosts.generated.json, the cache keys from cache-public-keys.nix.
# Hand the file to termuxpp's scripts/build-aarch64-bootstrap.py
# (--nixpp-setup-config); it is private, keep it out of public artifacts.
{ pkgs, inputs }:
let
  inherit (pkgs) lib;
  inherit (lib)
    assertMsg
    concatStringsSep
    filter
    hasInfix
    hasPrefix
    ;
  private = inputs.nixos-config-private;
  values = private.lib.termuxppSetup;
  hostKeys = builtins.fromJSON (builtins.readFile "${private.outPath}/data/ssh-hosts.generated.json");
  # Type and key only: the generated data keeps the key's comment.
  controllerHostKey = concatStringsSep " " (
    lib.take 2 (lib.splitString " " (lib.trim hostKeys.${values.controllerHost}.ed25519))
  );

  # nixpp reads `KEY=VALUE` lines: a value must be one non-empty line.
  oneLine =
    key: value:
    assert assertMsg (builtins.isString value) "nixpp setup config: ${key} must be a string";
    assert assertMsg (
      !(hasInfix "\n" value) && !(hasInfix "\r" value)
    ) "nixpp setup config: ${key} must be a single line";
    assert assertMsg (value != "") "nixpp setup config: ${key} must not be empty";
    value;
  # Lists are space separated: no blanks or commas inside an element.
  words =
    key: values:
    concatStringsSep " " (
      map (
        value:
        assert assertMsg (
          !(hasInfix " " value) && !(hasInfix "," value)
        ) "nixpp setup config: ${key} entries must not contain spaces or commas";
        oneLine key value
      ) values
    );
  entry = key: value: if value == null || value == "" then null else "${key}=${value}";
  optional = key: value: if value == null then null else entry key (oneLine key value);

  inherit (values) cache;
in
assert assertMsg (hasPrefix "ssh-ed25519 " controllerHostKey)
  "nixpp setup config: no ed25519 host key for ${values.controllerHost}";
assert assertMsg (hasPrefix "s3://" cache.store)
  "nixpp setup config: cache.store must be an s3:// store";
assert assertMsg (hasInfix "{host}" cache.pinUrl)
  "nixpp setup config: cache.pinUrl must contain {host}";
pkgs.writeText "nixpp-setup.conf" (
  "# Generated by nixos-config (profiles/specializations/termuxpp/setup-config.nix). Private.\n"
  + concatStringsSep "\n" (
    filter (line: line != null) [
      (entry "user" (oneLine "user" values.user))
      (optional "email" (values.email or null))
      (entry "controller" (oneLine "controller" values.controller))
      (entry "controller_host_key" (oneLine "controller_host_key" controllerHostKey))
      (entry "ssh_inputs" (words "sshInputs" (values.sshInputs or [ ])))
      (entry "worker_profiles" (words "workerProfiles" (values.workerProfiles or [ ])))
      (optional "dotfiles_repo" (values.dotfilesRepo or null))
      (entry "cache_store" (oneLine "cache_store" cache.store))
      (entry "cache_public_keys" (words "cache_public_keys" (import ./cache-public-keys.nix)))
      (entry "cache_pin_url" (oneLine "cache_pin_url" cache.pinUrl))
    ]
  )
  + "\n"
)
