diff --git a/src/notification/link_focus.h b/src/notification/link_focus.h
new file mode 100644
index 0000000..8c28b1a
--- /dev/null
+++ b/src/notification/link_focus.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "compositors/compositor_platform.h"
+#include "system/desktop_entry.h"
+#include "util/string_utils.h"
+
+#include <gio/gio.h>
+#include <string>
+#include <string_view>
+
+namespace notification {
+  // Some existing browser instances ignore activation tokens sent by xdg-open.
+  // Focus an existing window of the configured URI handler after launching it.
+  inline void focusLinkHandler(CompositorPlatform* platform, std::string_view url) {
+    if (platform == nullptr) return;
+    const auto colon = url.find(':');
+    if (colon == std::string_view::npos) return;
+    const std::string scheme(url.substr(0, colon));
+    GAppInfo* app = g_app_info_get_default_for_uri_scheme(scheme.c_str());
+    if (app == nullptr) return;
+    const char* appId = g_app_info_get_id(app);
+    std::string id = appId != nullptr ? StringUtils::toLower(appId) : std::string{};
+    g_object_unref(app);
+    if (id.empty()) return;
+    std::string wmClass;
+    for (const auto& entry : desktopEntries()) {
+      if (entry.idLower == id || entry.idLower + ".desktop" == id) {
+        wmClass = entry.startupWmClassLower;
+        break;
+      }
+    }
+    if (id.ends_with(".desktop")) id.resize(id.size() - 8);
+    const auto windows = platform->windowsForApp(id, wmClass);
+    if (!windows.empty()) platform->activateToplevelInfo(windows.back());
+  }
+}
