diff --git a/src/notification/link_open.h b/src/notification/link_open.h
new file mode 100644
index 000000000..0d67febaa
--- /dev/null
+++ b/src/notification/link_open.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "system/process.h"
+#include "net/url_open.h"
+
+#include <gio/gio.h>
+#include <string>
+#include <vector>
+
+namespace notification {
+  inline bool isTeamsLink(const std::string& url) {
+    GUri* uri = g_uri_parse(url.c_str(), G_URI_FLAGS_NONE, nullptr);
+    if (uri == nullptr) return false;
+    const char* scheme = g_uri_get_scheme(uri);
+    const char* host = g_uri_get_host(uri);
+    const bool result = scheme != nullptr && host != nullptr
+        && g_ascii_strcasecmp(scheme, "https") == 0
+        && (g_ascii_strcasecmp(host, "teams.microsoft.com") == 0
+            || g_ascii_strcasecmp(host, "teams.cloud.microsoft") == 0
+            || g_ascii_strcasecmp(host, "teams.live.com") == 0
+            || g_ascii_strcasecmp(host, "teams.microsoft.us") == 0);
+    g_uri_unref(uri);
+    return result;
+  }
+
+  inline bool openLink(const std::string& url, const std::string& token, bool forceChromium = false) {
+    if (forceChromium || isTeamsLink(url)) {
+      return process::runAsync(std::vector<std::string>{"chromium", url}, token);
+    }
+    return net::openInBrowser(url, token);
+  }
+}
