diff --git a/src/render/text/cairo_text_renderer.cpp b/src/render/text/cairo_text_renderer.cpp
index e3e367681..555c49606 100644
--- a/src/render/text/cairo_text_renderer.cpp
+++ b/src/render/text/cairo_text_renderer.cpp
@@ -671,0 +672,30 @@ void CairoTextRenderer::measureCursorStopsWrapped(
+int CairoTextRenderer::textIndexAt(float scale, std::string_view text, float fontSize, const TextFont& font,
+                                   float maxWidth, int maxLines, TextAlign align, TextEllipsize ellipsize,
+                                   bool markup, float x, float y) {
+  maybeSyncFontConfig();
+  if (m_pangoContext == nullptr || text.empty()) return -1;
+  PangoLayout* layout = buildLayout(scale, text, fontSize, font, maxWidth * scale, maxLines, align, ellipsize, markup);
+  PangoRectangle logical{};
+  pango_layout_get_extents(layout, nullptr, &logical);
+  // The rasterizer shifts the layout's left edge to the text origin.
+  const int px = static_cast<int>(std::round(x * scale * PANGO_SCALE))
+      + (logical.x / PANGO_SCALE) * PANGO_SCALE;
+  const int py = static_cast<int>(std::round(y * scale * PANGO_SCALE)) + pango_layout_get_baseline(layout);
+  int index = -1;
+  int trailing = 0;
+  if (!pango_layout_xy_to_index(layout, px, py, &index, &trailing)) index = -1;
+  // An ellipsis represents hidden text, not a clickable character.
+  PangoLayoutIter* iter = pango_layout_get_iter(layout);
+  do {
+    PangoLayoutRun* run = pango_layout_iter_get_run_readonly(iter);
+    if (run != nullptr && (run->item->analysis.flags & PANGO_ANALYSIS_FLAG_IS_ELLIPSIS) != 0) {
+      PangoRectangle rect{};
+      pango_layout_iter_get_run_extents(iter, nullptr, &rect);
+      if (px >= rect.x && px < rect.x + rect.width && py >= rect.y && py < rect.y + rect.height) index = -1;
+    }
+  } while (pango_layout_iter_next_run(iter));
+  pango_layout_iter_free(iter);
+  g_object_unref(layout);
+  return index;
+}
+
