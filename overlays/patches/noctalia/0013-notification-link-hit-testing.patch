diff --git a/src/notification/link_markup.h b/src/notification/link_markup.h
index 64cc3ce46..7eeda991d 100644
--- a/src/notification/link_markup.h
+++ b/src/notification/link_markup.h
@@ -7,0 +8,14 @@ namespace notification {
+  inline std::string linkAt(std::string_view text, int index) {
+    if (index < 0) return {};
+    static const std::regex pattern(R"(https?://[^\s<>"']+)");
+    const std::string source(text);
+    for (std::sregex_iterator it(source.begin(), source.end(), pattern), end; it != end; ++it) {
+      const auto start = static_cast<std::size_t>(it->position());
+      std::size_t length = static_cast<std::size_t>(it->length());
+      while (length > 0 && std::string_view(".,;:!?").find(source[start + length - 1]) != std::string_view::npos) --length;
+      if (static_cast<std::size_t>(index) >= start && static_cast<std::size_t>(index) < start + length)
+        return source.substr(start, length);
+    }
+    return {};
+  }
+
