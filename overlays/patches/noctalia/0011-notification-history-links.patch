+    static const std::regex pattern(R"(https?://[^\s<>"']+)");
+    const std::string text = std::string(summary) + "\n" + std::string(body);
+    std::string result;
+    for (std::sregex_iterator it(text.begin(), text.end(), pattern), end; it != end; ++it) {
