+      while (!url.empty() && std::string_view(".,;:!?").find(url.back()) != std::string_view::npos) {
+        url.pop_back();
+      }
+      if (!result.empty() && result != url) {
+        return {};
+      }
+      result = std::move(url);
+    }
+    return result;
+  }
