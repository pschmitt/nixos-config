+  std::vector<std::string> notificationLinks(const Notification& notification) {
+    static const std::regex pattern(R"(https?://[^\s<>"']+)");
+    const std::string text = notification.summary + "\n" + notification.body;
+    std::vector<std::string> links;
+    for (std::sregex_iterator it(text.begin(), text.end(), pattern), end; it != end; ++it) {
+      std::string url = it->str();
+      while (!url.empty() && std::string_view(".,;:!?").find(url.back()) != std::string_view::npos) {
+        url.pop_back();
+      }
+      if (!url.empty() && std::ranges::find(links, url) == links.end()) {
+        links.push_back(std::move(url));
+      }
+    }
+    return links;
+  }
+
+  std::unique_ptr<Button> makeLinkButton(const std::string& url, std::size_t index, float scale) {
+    auto button = ui::button({
+        .text = "Open link " + std::to_string(index + 1),
+        .glyph = "external-link",
+        .fontSize = Style::fontSizeCaption * scale,
+        .variant = ButtonVariant::Default,
+        .tooltip = url,
+    });
+    button->setOnClick([url] { (void)net::openInBrowser(url); });
+    return button;
+  }
