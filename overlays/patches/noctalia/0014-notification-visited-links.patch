--- a/src/notification/link_markup.h
+++ b/src/notification/link_markup.h
@@ -5,0 +6 @@
+#include <unordered_set>
@@ -7,0 +9,7 @@ namespace notification {
+  inline std::unordered_set<std::string>& visitedLinks() {
+    static std::unordered_set<std::string> links;
+    return links;
+  }
+
+  inline void markLinkVisited(const std::string& url) { visitedLinks().insert(url); }
+
@@ -45 +53,3 @@ namespace notification {
-      result += "<span foreground=\"#8ab4f8\" underline=\"single\">";
+      const auto url = source.substr(start, length);
