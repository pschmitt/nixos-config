diff --git a/tests/notification_history_dismiss_test.cpp b/tests/notification_history_dismiss_test.cpp
index 84a9b47d2..4e131163d 100644
--- a/tests/notification_history_dismiss_test.cpp
+++ b/tests/notification_history_dismiss_test.cpp
@@ -32,0 +33,11 @@ int main() {
+  {
+    NotificationManager urgencyManager;
+    const auto chromium = urgencyManager.addOrReplace({.appName = "Chromium", .summary = "chromium", .urgency = Urgency::Critical});
+    const auto chrome = urgencyManager.addOrReplace({.appName = "Google Chrome", .summary = "chrome", .urgency = Urgency::Critical});
+    const auto other = urgencyManager.addOrReplace({.appName = "other", .summary = "other", .urgency = Urgency::Critical});
+    const auto internal = urgencyManager.addOrReplace({.appName = "Chromium", .summary = "internal", .urgency = Urgency::Critical, .origin = NotificationOrigin::Internal, .persistInHistory = true});
+    TEST_CHECK(findEntry(urgencyManager, chromium)->notification.urgency == Urgency::Normal);
+    TEST_CHECK(findEntry(urgencyManager, chrome)->notification.urgency == Urgency::Normal);
+    TEST_CHECK(findEntry(urgencyManager, other)->notification.urgency == Urgency::Critical);
+    TEST_CHECK(findEntry(urgencyManager, internal)->notification.urgency == Urgency::Critical);
+  }
