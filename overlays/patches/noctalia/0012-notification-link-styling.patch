diff --git a/src/notification/link_markup.h b/src/notification/link_markup.h
new file mode 100644
index 000000000..64cc3ce46
--- /dev/null
+++ b/src/notification/link_markup.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <regex>
+#include <string>
+#include <string_view>
+
+namespace notification {
+  // Notification text is untrusted: escape it before adding our own markup.
+  inline std::string linkMarkup(std::string_view text) {
+    static const std::regex pattern(R"(https?://[^\s<>"']+)");
+    const std::string source(text);
+    std::string result;
+    auto appendEscaped = [&result](std::string_view part) {
+      for (char c : part) {
+        switch (c) {
+        case '&': result += "&amp;"; break;
+        case '<': result += "&lt;"; break;
+        case '>': result += "&gt;"; break;
+        default: result += c; break;
+        }
+      }
+    };
+    std::size_t cursor = 0;
+    for (std::sregex_iterator it(source.begin(), source.end(), pattern), end; it != end; ++it) {
+      const auto start = static_cast<std::size_t>(it->position());
+      std::size_t length = static_cast<std::size_t>(it->length());
+      while (length > 0 && std::string_view(".,;:!?").find(source[start + length - 1]) != std::string_view::npos) {
+        --length;
+      }
+      appendEscaped(std::string_view(source).substr(cursor, start - cursor));
+      result += "<span foreground=\"#8ab4f8\" underline=\"single\">";
+      appendEscaped(std::string_view(source).substr(start, length));
+      result += "</span>";
+      cursor = start + length;
+    }
+    appendEscaped(std::string_view(source).substr(cursor));
+    return result;
+  }
+}
