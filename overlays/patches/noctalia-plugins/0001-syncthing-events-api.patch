+-- Syncthing keeps one request open until events become available or its
+-- timeout expires. Reopen successful requests immediately; failed/invalid
+-- responses leave eventStream nil so update() performs a bounded recovery
+-- attempt after recoveryMs instead of reconnecting in a tight loop.
+local EVENT_TIMEOUT_SECONDS = 60
+-- noctalia's httpStream keys a stream by a Luau ref number that gets freed
+-- the instant the stream closes, and a fresh stream opened right after can
+-- be handed that same freed number back. Reconnecting once *per event*
+-- (limit=1) turns any burst (e.g. "pause all"/"resume all", which fires one
+-- event per folder plus a ConfigSaved) into a tight close/reopen loop, and
+-- under that churn a stale close notification for the just-closed stream
+-- can land on the ref number the new stream now owns — which fails a
+-- lookup, reports back as a bare failure with no Luau call involved (so
+-- nothing logs it), and counts straight against noctalia's error budget
+-- (this is what silently tripped "hit too many errors and was disabled").
+-- Batching many events into one long-poll response means one reconnect per
+-- *burst* instead of one per event, which keeps this collision vanishingly
+-- rare in practice.
+local EVENT_LIMIT = 100
+local eventStream = nil
+local eventGeneration = 0
+local eventSince = 0
+
+ensureEventStream = function()
+  if eventStream ~= nil or cfg.baseUrl == "" or cfg.apiKey == "" then
+    return false
+  end
+
+  eventGeneration += 1
+  local generation = eventGeneration
+  local lines = {}
+  local stream = noctalia.httpStream({
+    url = `{cfg.baseUrl}/rest/events?since={eventSince}&limit={EVENT_LIMIT}&timeout={EVENT_TIMEOUT_SECONDS}`,
+    method = "GET",
+    headers = { `X-API-Key: {cfg.apiKey}` },
+    allow_insecure_tls = cfg.insecure,
+  }, function(line)
+    if generation == eventGeneration then
+      table.insert(lines, line)
+    end
+  end, function(result)
+    if generation ~= eventGeneration then
+      return
+    end
+    eventStream = nil
+
+    if not result.ok then
+      publish(emptySnapshot("offline"))
+      return
+    end
+    if result.status == 401 or result.status == 403 then
+      publish(emptySnapshot("unauthorized"))
+      return
+    end
+    if result.status < 200 or result.status >= 300 then
+      publish(emptySnapshot("error", `HTTP {result.status}`))
+      return
+    end
+
+    -- Some event kinds (ConfigSaved in particular) embed the *entire* saved
+    -- config as `data` — 10+ KB, hundreds of pretty-printed lines, for a
+    -- payload we don't otherwise use. Fully JSON-decoding that (previously
+    -- via noctalia.json.decode) is what raised on a plain "pause all"/
+    -- "resume all" in the Syncthing GUI, and a raised error here counts
+    -- against noctalia's error budget and auto-disables the whole plugin
+    -- service ("hit too many errors and was disabled"). All we ever need
+    -- from an event is its own top-level, always-bare-numeric `id` (to
+    -- advance `since`) and whether at least one arrived — so pull just
+    -- that out of the raw body with a pattern instead of parsing `data`.
+    local handled, handlerErr = pcall(function()
+      local body = table.concat(lines, "\n")
+      local sawEvent = false
+      for idText in body:gmatch('"id"%s*:%s*(%d+)') do
+        sawEvent = true
+        local id = tonumber(idText) or 0
+        if id > eventSince then
+          eventSince = id
+        end
+      end
+
+      -- Status is still assembled from the regular REST endpoints, but those
+      -- requests now happen only after Syncthing reports an event. poll() also
+      -- coalesces bursts while a refresh is already in flight.
+      if sawEvent then
+        poll(true)
+      end
+    end)
+    if not handled then
+      noctalia.log(`[syncthing] event handling error: {handlerErr}`)
+    end
+    ensureEventStream()
+  end)
+
+  if stream == nil then
+    return false
+  end
+  eventStream = stream
+  return true
+end
