+    publish(nil, serviceActive)
+    noctalia.runAsync({ "@systemctl@", "--user", "is-active", "--quiet", "lan-mouse.service" }, function(status)
+      if request == generation then
+        polling = false
+        publish(nil, status.exitCode == 0)
+      end
+    end, 1000)
+  end, 1500)
 end

+publish(nil, false)
 poll()

