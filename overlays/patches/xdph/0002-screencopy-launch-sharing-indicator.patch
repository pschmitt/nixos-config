+void startScreencopyIndicator(const SSelectionData& data) {
+    static auto* const* PBINARY =
+        (Hyprlang::STRING* const)g_pPortalManager->m_sConfig.config->getConfigValuePtr("screencopy:custom_indicator_binary")->getDataStaticPtr();
+    if (std::string{*PBINARY}.empty())
+        return;
+
+    std::string target;
+    switch (data.type) {
+        case TYPE_OUTPUT:
+            target = std::format("screen:{}", data.output);
+            break;
+        case TYPE_GEOMETRY:
+            target = std::format("region:{}@{},{},{},{}", data.output, data.x, data.y, data.w, data.h);
+            break;
+        case TYPE_WINDOW: {
+            if (!g_pPortalManager->m_sHelpers.toplevelMapping)
+                return;
+            const auto address = g_pPortalManager->m_sHelpers.toplevelMapping->getWindowForToplevel(data.windowHandle);
+            if (!address)
+                return;
+            target = std::format("client:0x{:x}", address);
+            break;
+        }
+        default: return;
+    }
+
+    CProcess proc(*PBINARY, {"--spawn-indicator", target});
+    if (!proc.runSync())
+        Debug::log(ERR, "[screencopy] Could not start sharing indicator");
+}
