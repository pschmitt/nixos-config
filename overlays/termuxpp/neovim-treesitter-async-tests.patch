+  -- Folds are recomputed from an async parse (3ms budget per step, rescheduled when exceeded), so on
+  -- slow hosts the new levels land a few event loop iterations after the edit. Wait (bounded) for
+  -- the scheduled fold handlers, the root parse (foldexpr parses without injections, so children are
+  -- never valid; exclude them) and the handlers it schedules in turn.
+  local function wait_for_fold_update()
+    exec_lua(function()
+      local function drain()
+        local drained = false
+        vim.schedule(function()
+          drained = true
+        end)
+        assert(
+          vim.wait(5000, function()
+            return drained
+          end, 10),
+          'timed out draining scheduled fold updates'
+        )
+      end
+
+      local parser = vim.treesitter.get_parser(0, 'c')
+      drain()
+      assert(
+        vim.wait(5000, function()
+          return parser:is_valid(true)
+        end, 10),
+        'timed out waiting for the treesitter parse'
+      )
+      drain()
+    end)
+  end
+
