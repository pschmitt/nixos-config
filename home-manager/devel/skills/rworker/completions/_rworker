#compdef rworker rk
# zsh completion for rworker (skills/rworker). Actions, flags and values come
# from `rworker __spec`; workers, with kind, agent, topic and expiry, from
# `rworker __workers` (the cached last ls, refreshed in the background), so
# TAB never waits on the network.

_rworker_spec() {
  (( ${+_rworker_spec_cache} )) || _rworker_spec_cache=("${(@f)$(rworker __spec 2>/dev/null)}")
}

_rworker_workers() {
  local line name desc
  local -a workers
  for line in "${(@f)$(rworker __workers "${_rworker_action:-}" 2>/dev/null)}"
  do
    [[ -n "$line" ]] || continue
    name="${line%%$'\t'*}"
    desc="${line#*$'\t'}"
    workers+=("${name}:${desc//:/\\:}")
  done
  if [[ "$PREFIX" == *@* ]]
  then
    compset -P '*@'
  fi
  _describe -t workers 'worker' workers
}

_rworker_jobs() {
  local worker="${_rworker_job_worker:-}"
  local -a jobs
  jobs=(${(@f)$(rworker __jobs "$worker" 2>/dev/null)})
  _describe -t jobs 'job' jobs
}

_rworker() {
  _rworker_spec
  local line action
  local -a actions flags takes_worker
  for line in "${_rworker_spec_cache[@]}"
  do
    case "${line%% *}" in
      action)
        line="${line#action }"
        actions+=("${line%% *}:${line#* }")
        ;;
      worker)
        takes_worker=(${=line#worker })
        ;;
    esac
  done

  if (( CURRENT == 2 ))
  then
    _describe -t actions 'action' actions
    return
  fi

  action="${words[2]}"
  # For _rworker_workers (extend and prune list only ad-hoc workers).
  local _rworker_action="$action"
  if [[ "$action" == help ]]
  then
    (( CURRENT == 3 )) && _describe -t actions 'action' actions
    return
  fi

  # ssh -l USER NAME: the user, then the worker.
  if [[ "$action" == ssh && "${words[3]}" == -l ]]
  then
    if (( CURRENT == 4 ))
    then
      local -a users
      users=(${=${${(M)_rworker_spec_cache:#values user *}#values user }})
      _describe -t users 'user' users
      return
    elif (( CURRENT == 5 ))
    then
      _rworker_workers
      return
    elif (( CURRENT > 5 ))
    then
      _normal
      return
    fi
  fi
  if (( ${takes_worker[(Ie)$action]} )) && (( CURRENT == 3 )) && [[ "$PREFIX" != -* ]]
  then
    _rworker_workers
    return
  fi
  # ssh --create takes up's flags.
  if [[ "$action" == ssh && "${words[3]}" == --create ]] && (( CURRENT > 3 ))
  then
    action=up
  elif [[ "$action" == ssh ]] && (( CURRENT > 3 ))
  then
    _normal
    return
  fi
  # cp: NAME:PATH on one side, local files on the other.
  if [[ "$action" == cp ]]
  then
    if [[ "$PREFIX" == *:* ]]
    then
      _message 'path on the worker'
    else
      local -a targets
      targets=(${${(@f)$(rworker __workers 2>/dev/null)}%%$'\t'*})
      _alternative 'workers:worker:compadd -S : -a targets' 'files:file:_files'
    fi
    return
  fi
  if [[ "$action" == sync ]] && (( CURRENT == 4 ))
  then
    _files -/
    return
  fi

  local flag spec_flag values desc _rworker_job_worker="${words[3]:-}"
  if [[ "$action" == logs ]] && (( CURRENT >= 4 ))
  then
    flags+=('1:job:_rworker_jobs')
  fi
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "flag $action "* ]] || continue
    line="${line#flag $action }"
    spec_flag="${line%% *}"
    desc="${line#* }"
    if [[ "$spec_flag" == *=path ]]
    then
      flags+=("${spec_flag%%=*}[${desc}]:path:_files")
    elif [[ "$spec_flag" == *=* ]]
    then
      flag="${spec_flag%%=*}"
      values=$(printf '%s\n' "${_rworker_spec_cache[@]}" | sed -n "s/^values ${spec_flag#*=} //p")
      flags+=("${flag}[${desc}]:${spec_flag#*=}:(${values})")
    else
      flags+=("${spec_flag}[${desc}]")
    fi
  done
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "global "* ]] || continue
    line="${line#global }"
    flags+=("${line%% *}[${line#* }]")
  done
  flags+=('(-h --help)'{-h,--help}'[show help]')
  # _arguments must only see what follows the action (and its worker):
  # left in, they are positional arguments it has no spec for, and it
  # completes nothing (`rworker extend NAME --tt<TAB>`).
  local skip=2
  if (( ${takes_worker[(Ie)$action]} )) && [[ "$action" != prune ]]
  then
    skip=3
  elif [[ "$action" == up && "${words[2]}" == ssh ]]
  then
    # ssh --create: skip the --create too.
    skip=3
  fi
  words=("${words[1]}" "${(@)words[skip+1,-1]}")
  (( CURRENT -= skip - 1 ))
  if [[ "$action" == prune ]]
  then
    flags+=('*:worker:_rworker_workers')
  fi
  _arguments -s "${flags[@]}"
}

_rworker "$@"

