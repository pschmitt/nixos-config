#compdef rworker
# zsh completion for rworker (skills/rworker). Actions, flags and values come
# from `rworker __spec`, worker names from the local state directory, so the
# completion follows the client and never touches the network.

_rworker_spec() {
  (( ${+_rworker_spec_cache} )) || _rworker_spec_cache=("${(@f)$(rworker __spec 2>/dev/null)}")
}

_rworker_workers() {
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/rworker"
  local -a workers
  workers=(${state}/*.json(N:t:r))
  if [[ "$PREFIX" == *@* ]]
  then
    compset -P '*@'
  fi
  _describe -t workers 'worker' workers
}

_rworker() {
  _rworker_spec
  local line action
  local -a actions flags takes_worker
  for line in "${_rworker_spec_cache[@]}"
  do
    case "${line%% *}" in
      action)
        line="${line#action }"
        actions+=("${line%% *}:${line#* }")
        ;;
      worker)
        takes_worker=(${=line#worker })
        ;;
    esac
  done

  if (( CURRENT == 2 ))
  then
    _describe -t actions 'action' actions
    return
  fi

  action="${words[2]}"
  if [[ "$action" == help ]]
  then
    (( CURRENT == 3 )) && _describe -t actions 'action' actions
    return
  fi

  if (( ${takes_worker[(Ie)$action]} )) && (( CURRENT == 3 )) && [[ "$PREFIX" != -* ]]
  then
    _rworker_workers
    return
  fi
  # ssh --create takes up's flags.
  if [[ "$action" == ssh && "${words[3]}" == --create ]] && (( CURRENT > 3 ))
  then
    action=up
  elif [[ "$action" == ssh ]] && (( CURRENT > 3 ))
  then
    _normal
    return
  fi
  if [[ "$action" == sync ]] && (( CURRENT == 4 ))
  then
    _files -/
    return
  fi

  local flag spec_flag values desc
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "flag $action "* ]] || continue
    line="${line#flag $action }"
    spec_flag="${line%% *}"
    desc="${line#* }"
    if [[ "$spec_flag" == *=* ]]
    then
      flag="${spec_flag%%=*}"
      values=$(printf '%s\n' "${_rworker_spec_cache[@]}" | sed -n "s/^values ${spec_flag#*=} //p")
      flags+=("${flag}[${desc}]:${spec_flag#*=}:(${values})")
    else
      flags+=("${spec_flag}[${desc}]")
    fi
  done
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "global "* ]] || continue
    line="${line#global }"
    flags+=("${line%% *}[${line#* }]")
  done
  flags+=('(-h --help)'{-h,--help}'[show help]')
  _arguments "${flags[@]}"
}

_rworker "$@"

