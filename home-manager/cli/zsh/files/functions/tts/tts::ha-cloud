local usage="usage: $0 [-V VOICE | --gender m|male|f|female] [-l LANGUAGE] [-k] [-P] TEXT"
local help
local voice
local gender
local language=(--language en-US)
local keep noplay

zparseopts -D -E -K -- \
  {h,-help}=help \
  {V,-voice}:=voice \
  -gender:=gender \
  {l,-lang,-language}:=language \
  {k,-keep}=keep \
  {P,-dnp,-no-play,-noplay,-silent,q}=noplay || return 2

if [[ -n $help ]]
then
  print -- $usage >&2
  return 0
fi

[[ -n "$noplay" ]] && keep=1

if [[ -n "$voice" && -n "$gender" ]]
then
  echo_error "Choose either --voice or --gender"
  return 2
fi

if [[ -n "$gender" ]]
then
  case $gender[2] in
    m|male) gender=male ;;
    f|female) gender=female ;;
    *)
      echo_error "Invalid gender: $gender[2] (use m, male, f, or female)"
      return 2
      ;;
  esac
else
  gender=female
fi

voice=$voice[2]
language=$language[2]

# Parse full Azure voice spec (e.g. en-US-JennyNeural → language=en-US, voice=JennyNeural)
if [[ "$voice" =~ ^([a-z]{2}-[A-Z]{2})-(.+)$ ]]
then
  language="${match[1]}"
  voice="${match[2]}"
fi

# Short language aliases
case $language in
  en)   language=en-US ;;
  uk)   language=en-GB ;;
  de)   language=de-DE ;;
  fr)   language=fr-FR ;;
  es)   language=es-ES ;;
  it)   language=it-IT ;;
  nl)   language=nl-NL ;;
  pt)   language=pt-PT ;;
  pl)   language=pl-PL ;;
  ru)   language=ru-RU ;;
  zh)   language=zh-CN ;;
  ja)   language=ja-JP ;;
esac

if [[ -z "$voice" ]]
then
  if [[ "$gender" == male ]]
  then
    case $language in
      en-US) voice=GuyNeural ;;
      en-GB) voice=RyanNeural ;;
      de-DE) voice=ConradNeural ;;
      fr-FR) voice=HenriNeural ;;
      es-ES) voice=AlvaroNeural ;;
      it-IT) voice=DiegoNeural ;;
      nl-NL) voice=MaartenNeural ;;
      pt-PT) voice=DuarteNeural ;;
      pl-PL) voice=MarekNeural ;;
      ru-RU) voice=DmitryNeural ;;
      zh-CN) voice=YunxiNeural ;;
      ja-JP) voice=KeitaNeural ;;
      *)
        echo_error "No male voice configured for language: $language"
        return 2
        ;;
    esac
  else
    case $language in
      de-DE) voice=KatjaNeural ;;
      en-GB) voice=SoniaNeural ;;
      fr-FR) voice=DeniseNeural ;;
      es-ES) voice=ElviraNeural ;;
      it-IT) voice=ElsaNeural ;;
      nl-NL) voice=ColetteNeural ;;
      pt-PT) voice=RaquelNeural ;;
      pl-PL) voice=ZofiaNeural ;;
      ru-RU) voice=SvetlanaNeural ;;
      zh-CN) voice=XiaoxiaoNeural ;;
      ja-JP) voice=NanamiNeural ;;
      *) voice=JennyNeural ;;
    esac
  fi
fi

local text="${@[-1]//\"/\\\"}"
[[ "$#" -gt 0 ]] && set -- ${@[1,-2]}

hass::secrets-setup || return 1

local payload
payload=$(jq --null-input \
  --arg message "$text" \
  --arg language "$language" \
  --arg voice "$voice" \
  '{
    platform: "cloud",
    message: $message,
    language: $language,
    options: { voice: $voice }
  }')

local tts_url
if ! tts_url=$(curl -fsSL \
  -X POST \
  -H "Authorization: Bearer $HASS_TOKEN" \
  -H "Content-Type: application/json" \
  --data "$payload" \
  "${HASS_SERVER}/api/tts_get_url" | \
  jq -er '.url')
then
  echo_error "Failed to get TTS URL from Home Assistant"
  return 1
fi

local file
file=$(mktemp --suffix=.mp3)
[[ -n "$keep" ]] && echo_info "TTS file: $file"
[[ -z "$keep" ]] && trap "rm -f '$file'" EXIT

if ! curl -fsSL \
  -H "Authorization: Bearer $HASS_TOKEN" \
  "$tts_url" >! "$file"
then
  echo_error "Failed to download TTS audio"
  rm -f "$file"
  return 1
fi

if [[ -z "$noplay" ]]
then
  audio::play $@ "$file"
  return "$?"
fi

echo "$file"

