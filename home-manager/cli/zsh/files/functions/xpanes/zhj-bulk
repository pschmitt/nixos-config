local usage="Usage: $0 HOST [HOST..] -- CMD"
local ddindex=${@[(ie)--]}  # Get index of "--" (in $@)

if [[ "$#" -lt 3 ]] || ! [[ "$ddindex" -le ${#@} ]]
then
  echo "$usage"
  return 2
fi

# Insert "zhj" right after "--"
ssh-bulk ${@[@]:1:$(( ddindex - 1 ))} -- zhj ${@[@]:$(( ddindex + 1))}

