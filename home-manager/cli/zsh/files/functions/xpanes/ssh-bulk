local usage="Usage: $0 HOST [HOST...] [-- CMD]"
local hosts=()

# Host shortcuts
case "$1" in
  main)
    hosts=(fnuc lrz ntn x13)
    shift
    ;;
  fedora|k3s)
    hosts=(fnuc lrz ntn)
    shift
    ;;
  termux)
    hosts=(g4p mp4 m2s)
    shift
    ;;
  --help|help|-h)
    echo "$usage"
    return
    ;;
esac

while [[ -n "$*" ]]
do
  case "$1" in
    --)
      shift
      break;
      ;;
    *)
      hosts+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$hosts" ]]
then
  {
    echo "Missing hosts (SSH hosts)."
    echo "$usage"
  } >&2
  return 2
fi

local cmd=($@)

if [[ -n "$cmd[*]" ]]
then
  xpanes -t -s -c "ssh -o StrictHostKeyChecking=no {} -- $cmd[*]" \
    $hosts[@]
else
  xpanes --ssh "$hosts[@]"
fi

