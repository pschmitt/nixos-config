local img="$@[-1]"

if [[ -n "$img" && -f "$img" ]]
then
  shift
elif [[ -p /dev/stdin ]]
then
  echo_info "Reading image from pipe"
  img=$(mktemp -u --suffix=.png)
  trap "rm -f '$img'" EXIT
  cat > "$img"
else
  echo_info "Grabbing image from clipboard"
  local mime
  mime=$(wl-paste --list-types 2>/dev/null | grep -m1 '^image/')
  if [[ -z "$mime" ]]
  then
    echo_error "No image in clipboard"
    return 1
  fi
  img=$(mktemp -u --suffix=".${mime#image/}")
  trap "rm -f '$img'" EXIT
  wl-paste -t "$mime" > "$img"
fi

# Docs: https://tesseract-ocr.github.io/tessdoc/Command-Line-Usage.html
tesseract "$img" - --psm 3 $@

