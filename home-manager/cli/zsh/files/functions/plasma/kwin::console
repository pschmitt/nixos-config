# https://develop.kde.org/docs/plasma/kwin/#quick-start-desktop-console
if [[ -n "$1" ]]
then
  qdbus \
    org.kde.plasmashell \
    /PlasmaShell \
    org.kde.PlasmaShell.loadScriptInInteractiveConsole \
    "$(realpath "$1")"
else
  qdbus \
    org.kde.plasmashell \
    /PlasmaShell \
    org.kde.PlasmaShell.showInteractiveKWinConsole
fi

