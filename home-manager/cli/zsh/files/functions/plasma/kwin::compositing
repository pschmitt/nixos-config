local usage="Usage: $0 on|off"
local help

if [[ -z "$1" ]]
then
  echo "$usage" >&2
  return 2
fi

zparseopts -D -E \
  h=help -help=help

if [[ -n "$help" ]]
then
  echo "$usage"
  return
fi

local action

case "$1" in
  on|enable|up)
    action=on
    ;;
  off|disable|down)
    action=off
    ;;
  *)
    action=status
    ;;
esac


case "$action" in
  on)
    qdbus org.kde.KWin /Compositor org.kde.kwin.Compositing.resume
    ;;
  off)
    qdbus org.kde.KWin /Compositor org.kde.kwin.Compositing.suspend
    ;;
  *)
    qdbus org.kde.KWin /Compositor org.kde.kwin.Compositing.active
    ;;
esac

