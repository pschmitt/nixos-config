local usage="$0 [-l USER] HOST"

local interface
local remote_username=(-u root)

zparseopts -D -E -K -- \
  {i,-interface}:=interface \
  {l,-login,u,-username}:=remote_username
remote_username=$remote_username[2]
local -a extra_args=()
if [[ -n "$interface" ]]
then
  extra_args+=("-oextcap.sshdump.remoteinterface:${interface[2]}")
fi

local remote_host="$1"
if [[ -z "$remote_host" ]]
then
  echo $usage >&2
  return 1
fi

wireshark \
  "-oextcap.sshdump.remoteusername:${remote_username}" \
  "-oextcap.sshdump.remotehost:${remote_host}" \
  $extra_args \
  -i sshdump -k

