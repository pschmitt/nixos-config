local usage="Usage: $0 [--user] [-H HOST|--host=HOST] UNIT"

local help user host
local host_value
local load_state
zparseopts -D -E -K -- \
  {h,-help}=help \
  {u,-user}=user \
  H:=host -host:=host
user=${user:+--user}
host_value="${host[2]#=}"
if [[ -n "$host_value" ]]
then
  host_value="$(systemctl::normalize-remote-host "$host_value")"
fi

if [[ -n "$help" ]]
then
  echo "$usage"
  return 0
fi

local unit="$1"
if [[ -z "$unit" ]]
then
  echo_err "Missing unit"
  return 1
fi

load_state="$(systemctl::unit-property \
  $user \
  ${host_value:+--host=$host_value} \
  "$unit" \
  LoadState)"

[[ "$load_state" == "loaded" ]]

