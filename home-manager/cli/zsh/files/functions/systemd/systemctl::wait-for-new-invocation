local usage="Usage: $0 [--user] [-H HOST|--host=HOST] UNIT PREVIOUS_INVOCATION_ID"

local help user host
local host_value
local unit previous_invocation invocation_id
local attempts=0

zparseopts -D -E -K -- \
  {h,-help}=help \
  {u,-user}=user \
  H:=host -host:=host
user=${user:+--user}
host_value="${host[2]#=}"
if [[ -n "$host_value" ]]
then
  host_value="$(systemctl::normalize-remote-host "$host_value")"
fi

if [[ -n "$help" ]]
then
  echo "$usage"
  return 0
fi

unit="$1"
previous_invocation="$2"

if [[ -z "$unit" ]]
then
  echo_err "Missing unit"
  echo "$usage" >&2
  return 2
fi

while (( attempts < 100 ))
do
  invocation_id="$(systemctl::unit-property \
    $user \
    ${host_value:+--host=$host_value} \
    "$unit" \
    InvocationID)"

  if [[ -n "$invocation_id" && "$invocation_id" != "$previous_invocation" ]]
  then
    print -r -- "$invocation_id"
    return 0
  fi

  sleep 0.2
  (( attempts += 1 ))
done

return 1

