local usage="Usage: $0 [--user] [-H HOST|--host=HOST] UNIT INVOCATION_ID"

local help user host
local host_value
local unit invocation_id active_state
local attempts=0

zparseopts -D -E -K -- \
  {h,-help}=help \
  {u,-user}=user \
  H:=host -host:=host
user=${user:+--user}
host_value="${host[2]#=}"
if [[ -n "$host_value" ]]
then
  host_value="$(systemctl::normalize-remote-host "$host_value")"
fi

if [[ -n "$help" ]]
then
  echo "$usage"
  return 0
fi

unit="$1"
invocation_id="$2"

if [[ -z "$unit" || -z "$invocation_id" ]]
then
  echo_err "Missing unit or invocation ID"
  echo "$usage" >&2
  return 2
fi

while (( attempts < 1800 ))
do
  active_state="$(systemctl::unit-property \
    $user \
    ${host_value:+--host=$host_value} \
    "$unit" \
    ActiveState)"

  if [[ -z "$active_state" ]]
  then
    return 1
  fi

  if [[ "$active_state" != "activating" && "$active_state" != "deactivating" ]]
  then
    return 0
  fi

  sleep 0.5
  (( attempts += 1 ))
done

return 1

