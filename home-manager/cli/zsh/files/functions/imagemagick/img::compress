local usage="usage: $0 [--in-place] [INPUT] [OUTPUT]"
local inplace
zparseopts -D -E -K -- \
  {h,-help}=help \
  {i,-inplace,-in-place}=inplace

local input="${1:--}"
local output="${2:--}"

local tmpdir=$(mktemp -d)

if [[ "$input" == "-" ]]
then
  if [[ -n $inplace ]]
  then
    echo_error "Sorry, can't do that (--inplace + read file from stdin)"
    return 1
  fi
  cat > "${tmpdir}/${input}"
fi

local dest=$(mktemp -d)
trap "rm -rf '$dest'" EXIT

local img_format=$(img::type "$input")
local output_format="png" # default
case "$img_format" in
  jpeg)
    case "$output" in
      -|*.jpg|*.jpeg)
        output_format="mozjpeg"
        ;;
    esac
    ;;
esac

rimage "$output_format" --no-progress --directory "$dest" "$input" >&2 || return 1

local compressed="$(find $dest -type f | head -1)"

if [[ -n $inplace ]]
then
  cp -v "$compressed" "$input"
elif [[ "$output" == "-" ]]
then
  cat "$compressed"
else
  mv -v "$compressed" "$output"
fi

