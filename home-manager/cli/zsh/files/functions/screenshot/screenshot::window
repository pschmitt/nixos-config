local name=$1
local wm=$(window-manager::get-name)

case "$wm" in
  hyprland)
    local coords=$(window-manager::find-window "$name" | \
      jq -er '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    grim -g "$coords" -
    ;;
  *)
    echo_error "Unsupported window manager: $wm"
    return 1
    ;;
esac

