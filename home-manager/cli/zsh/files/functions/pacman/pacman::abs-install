local usage="Usage: $0 PACKAGE"

if [[ -z "$1" ]]
then
  echo "$usage" >&2
  return 2
fi

case "$1" in
  help|h|-h|--help)
    echo "$usage"
    return
    ;;
esac

local pkg="$1"
local tmpdir="$(mktemp -d -t pacman_abs_install.XXXXX)"
trap "rm -rf '$tmpdir'" EXIT INT

local cwd="$PWD"
cd "$tmpdir"

# FIXME asp is deprecated, use pkgctl!
# https://archlinux.org/news/git-migration-completed/
# asp update
# asp export "$pkg"
pkgctl repo clone "$pkg"

local rc="$?"

if [[ "$rc" -ne 0 ]]
then
  return "$rc"
fi

cd "$pkg"
makepkg -si
rc="$?"

# jump back and clean up
cd "$cwd"
rm -rf "$tmpdir"

return "$rc"

