yq -p xml -o json '.nmaprun' | \
  jq -e '[
    if (.host | type == "array")
    then
      .host[]
    else
      .host
    end |
    .ports.port = (
      if (.ports.port | type != "array")
      then
        [.ports.port]
      else
        .ports.port
      end
    )
  ]'

