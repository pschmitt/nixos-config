local inventory
local nodes

zparseopts -D -- "n+:=nodes"

if [[ -z "$*" ]]
then
  echo "Missing command" >&2
  return 2
fi

if [[ -n "$nodes" ]]
then
  # Remove all occurences of "-n"
  nodes=("${(@)nodes:#-n}")
else
  nodes=($ETCD_NODES[@])
fi

# join array
inventory="$(sed -r 's/:[0-9]+//g' <<< ${(j:,:)nodes})"

ansible -i "$inventory" -m raw -a "$*" all

