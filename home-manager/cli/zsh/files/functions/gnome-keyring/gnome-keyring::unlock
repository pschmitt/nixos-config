# local arg_collections=$(busctl --no-pager --user get-property \
#       org.freedesktop.secrets /org/freedesktop/secrets \
#       org.freedesktop.Secret.Service Collections)
# busctl -j --no-pager --user call \
#   org.freedesktop.secrets \
