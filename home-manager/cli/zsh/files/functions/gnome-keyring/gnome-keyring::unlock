local no_callback nointeractive
zparseopts -D -E -K -- \
  {n,-no-callback}=no_callback \
  {N,-nointeractive,-non-interactive,-noninteractive}=nointeractive

if gnome-keyring::status
then
  # Nothing to do
  echo_info "Keyrings/collections are already unlocked"
  return
fi

echo_info --notify "Unlocking all keyrings/collections"

# FIXME this is not working since this returns a prompt ID and
