local plugin="$1"
local target_dir
target_dir=$(find "${TMUX_PLUGIN_MANAGER_PATH}/" \
  -maxdepth 1 \
  -type d \
  -iname "*${plugin}*" \
  -print \
  -quit)

if [[ -z "$target_dir" ]]
then
  echo_error "Could not find any TPM plugin matching \"*${plugin}*\""
  return 1
fi

cd "${target_dir}"

