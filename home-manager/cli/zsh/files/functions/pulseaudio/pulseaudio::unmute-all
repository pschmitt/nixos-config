local kind s
local -a devices

for kind in sources sinks
do
  echo_info "Unmuting all $kind"
  devices=($(pulseaudio::list $kind))
  for s in $devices
  do
    if [[ $kind == sinks ]]
    then
      pulseaudio::unmute-sink "$s"
    else
      pulseaudio::unmute-source "$s"
    fi
  done
done

