local usage="$0 WORD"
local i char

if [[ -t 0 ]]
then
  input="$*"
else
  # Read from pipe
  input=$(cat)
fi

local -A T9_TABLE=(
  [a]="2"
  [b]="2"
  [c]="2"

  [d]="3"
  [e]="3"
  [f]="3"

  [g]="4"
  [h]="4"
  [i]="4"

  [j]="5"
  [k]="5"
  [l]="5"

  [m]="6"
  [n]="6"
  [o]="6"

  [p]="7"
  [q]="7"
  [r]="7"
  [s]="7"

  [t]="8"
  [u]="8"
  [v]="8"

  [w]="9"
  [x]="9"
  [y]="9"
  [z]="9"
)

if [[ -z "$input" ]]
then
  echo "$usage" >&2
  return 2
fi

for (( i=0; i<${#input}; i++ ))
do
  char="${input:$i:1}"
  echo -n ${T9_TABLE[$char]}
done
echo

