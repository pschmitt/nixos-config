local usage="usage: $0 [PR_NUMBER]"
local pr_number="$1"

if [[ -z $pr_number || ! $pr_number =~ ^[0-9]+$ ]]
then
  echo_error "Missing or invalid PR number${pr_number:+: $pr_number}"
  echo $usage >&2
  echo_info "List of PRs:"
  nixpkgs::digest
  return 2
fi

# gh pr view --web --repo NixOS/nixpkgs "$pr_number"
local url="https://github.com/NixOS/nixpkgs/pull/${pr_number}"
browser::open-or-focus "$url"

