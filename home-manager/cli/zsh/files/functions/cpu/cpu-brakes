local limit interval
local pid
local -a target

zparseopts -D -K -E \
  i:=interval -interval:=interval \
  l:=limit -limit:=limit

limit=${limit[2]:-100}
interval=${interval[2]:-1}
target=($@)

echo_info "Hunting for $target PID and limiting it to $limit/$(( $(nproc) * 100 )) CPU"

while true
do
  if ! pid=$(pgrep -f "$target" | head -1) || [[ -z "$pid" ]]
  then
    echo_warning "No PID found for $*"
    sleep $interval
    continue
  fi

  sudo cpulimit \
    --limit="$limit" \
    --lazy \
    --include-children \
    --pid="$pid"

  echo_info "Process exited: $target ($pid)"
  sleep $interval
done

