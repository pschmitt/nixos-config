local output
zparseopts -D -E -K \
  o:=output

local pid="$1"

if [[ -z "$pid" ]]
then
  echo "Usage: $0 PID" >&2
  return 2
fi

if ! [[ $pid =~ ^[0-9]+$ ]]
then
  local pid_resolved="$pid"
  pid_resolved=$(pgrep -f "$pid" | head -1)
  [[ -n $pid_resolved ]] && pid=$pid_resolved
fi

if ! kill -0 $pid &>/dev/null
then
  echo_error "No such process: $pid"
  return 1
fi

local cmd=$(ps -o command= $pid)
echo_info "Resolved PID: $pid [$cmd]"

local ppid=$(ps -o ppid= $pid | awk '{ print $1 }')

if [[ -z "$ppid" ]]
then
  echo_warning "Failed to find PPID of $pid"
  return 1
fi

ps $output $ppid

