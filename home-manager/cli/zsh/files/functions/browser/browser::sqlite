local db=(--database weave/bookmarks.sqlite)
local sep=(--separator $'\t')

zparseopts -D -E -K -- \
  {d,-db,-db-name,-database}:=db \
  {s,-sep,-separator}:=sep

local query="$*"
local profile_dir
if ! profile_dir=$(firefox::profile-dir)
then
  return 1
fi
local file="${profile_dir}/${db[2]}"

sqlite3 -separator "$sep[2]" "file:${file}?immutable=1" "${query}"

